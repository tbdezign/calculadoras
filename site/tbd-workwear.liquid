  // logo on the real photo, at the spot saved in the calculator (or a standard spot)
  var DEF = { lc: { cx: .63, cy: .34, maxW: .15, maxH: .12 }, ff: { cx: .5, cy: .47, maxW: .36, maxH: .38 }, fb: { cx: .5, cy: .42, maxW: .38, maxH: .40 }, sl: { cx: .5, cy: .33, maxW: .14, maxH: .10 } };
  function view(st, color, side, spot, label) {
    var ph = photoFor(st, color, side), pl = (ph && ph.place && ph.place[spot]) || DEF[spot], hex = hexOf(st, color);
    var dark = !/white|natural|silver|grey|gray|light|ceil|sand|oatmeal|yellow|pink/i.test(color);
    var logo = O.logo && O.logo.url ? '<img src="' + O.logo.url + '" alt="">' : '<span style="background:' + (dark ? '#fff' : '#051024') + ';color:' + (dark ? '#051024' : '#fff') + '">LOGO</span>';
    var box = 'left:' + (pl.cx - pl.maxW / 2) * 100 + '%;top:' + (pl.cy - pl.maxH / 2) * 100 + '%;width:' + pl.maxW * 100 + '%;height:' + pl.maxH * 100 + '%';
    var base = ph ? '<img src="' + esc(ph.url) + '" alt="">' : (side === 'front' ? shapeSvg(st.type, hex) : '');
    if (!base) return '';
    return '<div class="ww-prev"><div class="ww-pimg">' + base + '<div class="ww-logo" style="' + box + '">' + logo + '</div></div><b>' + esc(st.name) + '</b><small>' + esc(color) + ' · ' + label + '</small></div>';
  }
  function previews() {
    var out = '';
    O.lines.filter(function (l) { return qtyOf(l) > 0; }).forEach(function (l) {
      var st = byCode[l.code], pl = O.placement;
      var front = pl === 'lc' || pl === 'lcb' || pl === 'other' ? 'lc' : pl === 'ff' || pl === 'fb' ? 'ff' : null;
      var back = pl === 'bk' || pl === 'fb' || pl === 'lcb';
      if (front) out += view(st, l.color, 'front', front, 'Front' + (pl === 'other' ? ' (placement you described)' : ''));
      if (back) out += view(st, l.color, 'back', 'fb', 'Back') || (front ? '' : view(st, l.color, 'front', 'ff', 'Back (shown on front)'));
      if (O.sleeves) out += view(st, l.color, 'side', 'sl', O.sleeves === 1 ? 'Sleeve' : 'Sleeves (both)');
    });
