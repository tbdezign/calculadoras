<style>
  .ww * { box-sizing: border-box; }
  .ww { font-family: 'Poppins', 'Helvetica Neue', sans-serif; color: #051024; -webkit-font-smoothing: antialiased; background: #f7f7f7; }
  .ww button { font-family: inherit; cursor: pointer; }
  .ww button:disabled { cursor: default; opacity: .45; }
  .ww a { color: #1a7698; }
  .ww-hero-wrap { background: #fff; border-bottom: 1px solid #e2e2e2; padding: 0 5vw; }
  .ww-hero { padding: 28px 0 34px; max-width: 1180px; margin: 0 auto; }
  .ww-crumb { font-size: 13px; color: #6b7280; margin-bottom: 18px; }
  .ww-crumb a { color: #051024; text-decoration: none; }
  .ww-crumb a:hover { text-decoration: underline; }
  .ww-tag { font-family: 'Montserrat', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #749a37; background: #f2f8e8; border: 1px solid #c8e49a; padding: 5px 16px; border-radius: 20px; display: inline-block; margin-bottom: 20px; }
  .ww-h1 { font-family: 'Montserrat', 'Helvetica Neue', sans-serif; font-size: clamp(28px, 3.5vw, 40px); font-weight: 700; line-height: 1.1; letter-spacing: -.025em; margin: 0 0 14px; }
  .ww-h1 em { font-style: italic; color: #41a9cc; font-weight: 400; }
  .ww-sub { font-size: 15px; font-weight: 300; color: #6b7280; line-height: 1.7; margin: 0 0 20px; max-width: 760px; }
  .ww-trust { display: flex; flex-wrap: wrap; gap: 10px 22px; }
  .ww-trust span { font-family: 'Montserrat', sans-serif; font-size: 12px; font-weight: 600; display: flex; align-items: center; gap: 6px; }
  .ww-trust span::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: #91bc4d; }
  .ww-main { max-width: 1180px; margin: 0 auto; padding: 24px 5vw 56px; }
  @media (min-width: 1300px) { .ww-main { padding-left: 0; padding-right: 0; } }

  /* filters */
  .ww-filters { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 16px; }
  .ww-dd { position: relative; }
  .ww-ddbtn { display: inline-flex; align-items: center; gap: 8px; padding: 9px 14px; border-radius: 10px; border: 1.5px solid #d6dbe1; background: #fff; color: #051024; font-size: 14px; font-weight: 500; }
  .ww-ddbtn.on { background: #051024; color: #fff; border-color: #051024; }
  .ww-menu { position: absolute; top: calc(100% + 6px); left: 0; z-index: 20; min-width: 220px; background: #fff; border: 1px solid #e6e8ec; border-radius: 12px; box-shadow: 0 10px 30px rgba(5,16,36,.12); padding: 8px; }
  .ww-opt { display: flex; align-items: center; gap: 10px; width: 100%; padding: 10px; border: none; border-radius: 8px; background: #fff; color: #051024; font-size: 14px; text-align: left; }
  .ww-opt.on { background: #f3f8ea; }
  .ww-box { width: 18px; height: 18px; flex: none; border-radius: 4px; border: 1.5px solid #c9d1da; display: inline-flex; align-items: center; justify-content: center; color: #fff; font-size: 12px; font-weight: 700; }
  .ww-opt.on .ww-box { background: #051024; border-color: #051024; }
  .ww-box.dot { border-radius: 50%; }
  .ww-opt.on .ww-box.dot { border-color: #1a7698; box-shadow: 0 0 0 2px #fff inset; }
  .ww-count { margin-left: auto; font-size: 14px; color: #4b5563; }
  .ww-link { border: none; background: none; color: #1a7698; font-size: 14px; font-weight: 600; padding: 8px; }

  /* catalog grid */
  .ww-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 16px; }
  .ww-card { background: #fff; border: 1px solid #e2e2e2; border-radius: 14px; overflow: hidden; display: flex; flex-direction: column; transition: box-shadow .2s, transform .2s; }
  .ww-card:hover { box-shadow: 0 4px 20px rgba(5,16,36,.08); transform: translateY(-2px); }
  .ww-img { background: #fff; aspect-ratio: 1; display: flex; align-items: center; justify-content: center; overflow: hidden; position: relative; }
  .ww-img img { width: 92%; height: 92%; object-fit: contain; display: block; }
  .ww-card .ww-img { border-bottom: 1px solid #f0f0f0; }
  .ww-img svg { width: 62%; height: 62%; }
  .ww-cbody { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .ww-badges { display: flex; flex-wrap: wrap; gap: 6px; }
  .ww-badge { font-size: 10.5px; font-weight: 600; letter-spacing: .8px; text-transform: uppercase; border-radius: 4px; padding: 3px 8px; }
  .ww-cname { font-family: 'Montserrat', sans-serif; font-size: 14px; font-weight: 700; line-height: 1.35; margin: 0; }
  .ww-dots { display: flex; gap: 5px; flex-wrap: wrap; align-items: center; }
  .ww-dots span.d { width: 16px; height: 16px; border-radius: 50%; border: 1px solid #c9d1da; }
  .ww-dots small { font-size: 12px; color: #4b5563; }
  .ww-from { font-size: 14px; color: #4b5563; margin-top: auto; }
  .ww-from b { color: #051024; font-size: 17px; }
  .ww-cta { display: block; width: 100%; text-align: center; padding: 11px; border-radius: 10px; border: none; background: #051024; color: #fff !important; text-decoration: none; font-weight: 600; font-size: 14px; }
  .ww-cta:hover { background: #1a7698; }
  .ww-note { font-size: 12px; color: #4b5563; margin: 16px 0 0; }
  .ww-empty { background: #fff; border: 1px dashed #c9d1da; border-radius: 14px; padding: 32px; text-align: center; color: #4b5563; font-size: 15px; }

  /* order flow */
  .ww-steps { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 22px; }
  .ww-step { display: flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 999px; border: 1px solid #d6dbe1; background: #fff; color: #051024; font-size: 13px; font-weight: 500; }
  .ww-step i { width: 22px; height: 22px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 600; font-style: normal; background: #eef1f4; color: #4b5563; }
  .ww-steps .ww-sep { align-self: center; color: #9ca3af; font-size: 14px; }
  .ww-step.cur { background: #051024; color: #fff; border-color: #051024; }
  .ww-step.cur i { background: #41a9cc; color: #fff; }
  .ww-step.done i { background: #91bc4d; color: #fff; }
  .ww-cols { display: flex; flex-wrap: wrap; gap: 24px; align-items: flex-start; }
  .ww-panel { flex: 999 1 560px; min-width: 0; background: #fff; border: 1px solid #e6e8ec; border-radius: 18px; padding: 28px; }
  .ww-aside { flex: 1 1 280px; min-width: 0; background: #fff; border: 1px solid #e6e8ec; border-radius: 18px; padding: 22px; position: sticky; top: 16px; }
  .ww-h2 { font-family: 'Montserrat', sans-serif; font-size: 22px; font-weight: 700; letter-spacing: -.2px; margin: 0 0 4px; }
  .ww-p { margin: 0 0 18px; color: #4b5563; font-size: 14px; }
  .ww-q { font-weight: 600; font-size: 15px; margin: 18px 0 10px; }
  .ww-mini { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; margin-bottom: 22px; }
  .ww-mcard { border: 1px solid #e3e3e3; border-radius: 12px; padding: 10px; display: flex; flex-direction: column; gap: 6px; background: #fff; text-align: left; }
  .ww-mcard .ww-img { border-radius: 8px; }
  .ww-mcard b { font-size: 13px; line-height: 1.3; font-weight: 600; }
  .ww-mcard small { font-size: 12px; color: #4b5563; }
  .ww-mini.few { grid-template-columns: repeat(4, minmax(0, 1fr)) 150px; }
  .ww-more { border-style: dashed; justify-content: center; align-items: center; text-align: center; background: #fafbfc; }
  .ww-morebtn { border: none; background: none; color: #051024; font-weight: 600; font-size: 14px; display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 10px; }
  .ww-morebtn b { font-family: 'Montserrat', sans-serif; font-size: 26px; color: #1a7698; }
  .ww-more .ww-link { font-size: 13px; text-decoration: underline; }
  .ww-add { margin-top: auto; padding: 8px; border-radius: 8px; border: 1.5px solid #051024; background: #fff; color: #051024; font-weight: 600; font-size: 13px; }
  .ww-add:hover { background: #051024; color: #fff; }
  .ww-line { border: 1px solid #e3e3e3; border-radius: 12px; padding: 16px; margin-bottom: 12px; }
  .ww-lhead { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 10px; }
  .ww-lhead > div { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .ww-thumb { width: 48px; height: 48px; flex: none; border-radius: 8px; background: #fff; border: 1px solid #eee; overflow: hidden; display: flex; align-items: center; justify-content: center; }
  .ww-thumb img { width: 100%; height: 100%; object-fit: contain; }
  .ww-thumb svg { width: 80%; height: 80%; }
  .ww-sw { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
  .ww-sw button { width: 30px; height: 30px; border-radius: 50%; border: 2px solid #d6dbe1; box-shadow: inset 0 0 0 2px #fff; padding: 0; }
  .ww-sw button.on { border-color: #1a7698; }
  .ww-sizes { display: grid; grid-template-columns: repeat(auto-fill, minmax(92px, 1fr)); gap: 8px; }
  .ww-size { border: 1px solid #e3e3e3; border-radius: 8px; padding: 6px; text-align: center; }
  .ww-size label { display: block; font-size: 12px; color: #4b5563; margin-bottom: 4px; }
  .ww-size div { display: flex; align-items: center; justify-content: space-between; gap: 4px; }
  .ww-size button { width: 28px; height: 28px; border-radius: 6px; border: 1px solid #d6dbe1; background: #fff; font-size: 16px; line-height: 1; padding: 0; flex: none; }
  .ww-size input { width: 100%; min-width: 0; border: none; text-align: center; font-weight: 600; font-size: 16px; font-family: inherit; background: transparent; -moz-appearance: textfield; padding: 0; }
  .ww-size input::-webkit-outer-spin-button, .ww-size input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .ww-dash { border: 1.5px dashed #c9d1da; border-radius: 12px; padding: 20px; text-align: center; color: #4b5563; font-size: 14px; }
  .ww-choice { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; }
  .ww-ch { text-align: left; padding: 14px 16px; border-radius: 14px; border: 2px solid #e3e3e3; background: #fff; color: #051024; }
  .ww-ch.on { border-color: #1a7698; background: #f5fafc; }
  .ww-ch b { display: block; font-size: 15px; margin-bottom: 3px; }
  .ww-ch span { font-size: 13px; color: #4b5563; }
  .ww-ch .ww-swatch { height: 46px; border-radius: 8px; margin-bottom: 10px; }
  .ww-ch .ww-pop { display: inline-block; font-size: 10.5px; font-weight: 600; letter-spacing: .8px; text-transform: uppercase; color: #4f7a1f; background: #eef6e2; border-radius: 4px; padding: 3px 9px; margin-bottom: 6px; }
  .ww-pills { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .ww-pill { padding: 9px 16px; border-radius: 999px; border: 1.5px solid #d6dbe1; background: #fff; color: #051024; font-weight: 600; font-size: 14px; }
  .ww-pill.on { background: #051024; border-color: #051024; color: #fff; }
  .ww-upload { width: 100%; padding: 22px; border-radius: 12px; border: 1.5px dashed #c9d1da; background: #fafbfc; color: #051024; font-size: 14px; display: flex; align-items: center; justify-content: center; gap: 12px; }
  .ww-upload.on { border-color: #1a7698; }
  .ww-upload img { max-height: 54px; max-width: 120px; object-fit: contain; }
  .ww-hint { font-size: 12px; color: #1a7698; margin: -4px 0 10px; }
  .ww-method { border-radius: 14px; background: #051024; color: #fff; padding: 18px 20px; margin-bottom: 14px; }
  .ww-method small { font-size: 12px; letter-spacing: 1px; text-transform: uppercase; color: #9fd3e6; }
  .ww-method b { display: block; font-family: 'Montserrat', sans-serif; font-size: 24px; margin: 2px 0 4px; }
  .ww-method p { font-size: 14px; color: #d5dee8; margin: 0; }
  .ww-method em { display: block; font-style: normal; font-size: 13px; color: #9fd3e6; margin-top: 8px; }
  .ww-msg { border-radius: 12px; padding: 12px 14px; font-size: 14px; margin-bottom: 14px; }
  .ww-msg.green { border: 1.5px solid #91bc4d; background: #f3f8ea; }
  .ww-msg.grey { border: 1px solid #e3e3e3; background: #fafbfc; }
  .ww-msg.red { border: 1px solid #f3c9c9; background: #fdf2f2; color: #8a1c1c; }
  .ww-ta { width: 100%; padding: 12px; border-radius: 10px; border: 1.5px solid #c9d1da; font-family: inherit; font-size: 16px; resize: vertical; }
  .ww-spot { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; padding: 10px 12px; border: 1px solid #e3e3e3; border-radius: 10px; margin-bottom: 8px; }
  .ww-spot > b { font-size: 14px; min-width: 56px; }
  .ww-spot .ww-pill { padding: 7px 12px; font-size: 13px; }
  .ww-prevs { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; }
  .ww-prev { border: 1px solid #e3e3e3; border-radius: 12px; padding: 12px; text-align: center; }
  .ww-pimg { position: relative; aspect-ratio: 1; background: #fff; border-radius: 8px; overflow: hidden; }
  .ww-pimg > img, .ww-pimg > svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .ww-logo { position: absolute; display: flex; align-items: center; justify-content: center; }
  .ww-logo img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .ww-logo span { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 10px; border-radius: 3px; }
  .ww-pimg { cursor: zoom-in; }
  .ww-zoom { position: fixed; inset: 0; z-index: 9999; background: rgba(5,16,36,.82); display: flex; align-items: center; justify-content: center; padding: 16px; cursor: zoom-out; }
  .ww-zoom .ww-pimg { width: min(92vw, 88vh, 900px); cursor: zoom-out; border-radius: 12px; }
  .ww-zoom .ww-logo span { font-size: 22px; }
  .ww-zoom-x { position: absolute; top: 14px; right: 18px; color: #fff; font-size: 34px; line-height: 1; background: none; border: none; }
  .ww-prev b { display: block; font-size: 13px; margin-top: 8px; }
  .ww-prev small { display: block; font-size: 12px; color: #4b5563; }
  .ww-nav { display: flex; justify-content: space-between; gap: 12px; margin-top: 26px; flex-wrap: wrap; }
  .ww-btn { padding: 12px 24px; border-radius: 10px; border: none; background: #051024; color: #fff; font-weight: 600; font-size: 14px; }
  .ww-btn.ghost { border: 1.5px solid #c9d1da; background: #fff; color: #051024; }
  .ww-btn.pay { background: #1a7698; }
  .ww-aside h3 { font-family: 'Montserrat', sans-serif; font-size: 17px; margin: 0 0 12px; }
  .ww-row { display: flex; justify-content: space-between; gap: 10px; font-size: 14px; margin-top: 6px; }
  .ww-row b { text-align: right; }
  .ww-sline { display: flex; justify-content: space-between; gap: 10px; font-size: 13px; padding: 6px 0; border-bottom: 1px solid #f0f0f0; }
  .ww-total { display: flex; justify-content: space-between; align-items: baseline; font-size: 15px; margin-top: 14px; padding-top: 12px; border-top: 2px solid #051024; }
  .ww-total b { font-family: 'Montserrat', sans-serif; font-size: 24px; }
  .ww-fine { font-size: 12px; color: #4b5563; margin-top: 8px; }
  .ww-loading { padding: 40px; text-align: center; color: #6b7280; }
  @media (max-width: 768px) {
    .ww-panel { padding: 18px; }
    .ww-grid { grid-template-columns: 1fr 1fr; gap: 10px; }
    .ww-cbody { padding: 10px 12px 12px; }
    .ww-cname { font-size: 13px; }
    .ww-aside { position: static; }
    .ww-mini, .ww-mini.few { grid-template-columns: 1fr 1fr; }
    .ww-more { grid-column: 1 / -1; flex-direction: row; gap: 14px; }
    .ww-morebtn { flex-direction: row; gap: 8px; white-space: nowrap; }
    .ww-morebtn b { font-size: 18px; }
    .ww-steps { gap: 4px; }
    .ww-step { padding: 6px; }
    .ww-step:not(.cur) .ww-lbl { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .ww-step.cur { padding-right: 14px; }
    .ww-count { margin-left: 0; width: 100%; }
  }
</style>

<div class="ww" id="tbd-ww" data-api="{{ section.settings.api_url | escape }}">
  <div class="ww-hero-wrap"><div class="ww-hero" id="ww-hero"></div></div>
  <div class="ww-main" id="ww-app"><div class="ww-loading">Loading styles…</div></div>
</div>

{% raw %}
<script>
(function () {
  var root = document.getElementById('tbd-ww'); if (!root) return;
  var API = root.getAttribute('data-api');
  var hero = document.getElementById('ww-hero'), app = document.getElementById('ww-app');

  // ── shapes for styles without a photo ──
  var SHAPE = {
    'T-shirt': 'M35 12 L22 16 L8 30 L18 40 L26 34 L26 90 L74 90 L74 34 L82 40 L92 30 L78 16 L65 12 Q50 22 35 12 Z',
    'Long sleeve': 'M35 12 L22 16 L5 56 L15 60 L26 36 L26 90 L74 90 L74 36 L85 60 L95 56 L78 16 L65 12 Q50 22 35 12 Z',
    'Polo': 'M36 12 L22 16 L8 30 L18 40 L26 34 L26 90 L74 90 L74 34 L82 40 L92 30 L78 16 L64 12 L56 22 L50 34 L44 22 Z'
  };
  SHAPE['Scrub top'] = 'M34 12 L22 16 L8 30 L18 40 L26 34 L26 90 L74 90 L74 34 L82 40 L92 30 L78 16 L66 12 L50 38 Z';
  function shapeSvg(type, hex) { return '<svg viewBox="0 0 100 100" aria-hidden="true"><path d="' + (SHAPE[type] || SHAPE['T-shirt']) + '" fill="' + (hex || '#fff') + '" stroke="#c9d1da" stroke-width="1.2" stroke-linejoin="round"/></svg>'; }

  var MAT = { 'Performance': ['#1a5f78', '#e6f4f9'], '100% cotton': ['#4f7a1f', '#eef6e2'], 'Cotton blend': ['#6b4e1f', '#f7efe2'] };
  var FAMHEX = { White: '#ffffff', Black: '#1d1d1f', Navy: '#232c44', Blue: '#2554a6', Grey: '#9ea3a8', Red: '#b3202a', Green: '#24452f' };
  function fam(n) {
    n = String(n).toLowerCase();
    if (/white|natural/.test(n)) return 'White';
    if (/black/.test(n)) return 'Black';
    if (/navy/.test(n)) return 'Navy';
    if (/royal|blue|ceil|caribbean|sapphire|teal|aqua/.test(n)) return 'Blue';
    if (/grey|gray|graphite|silver|charcoal|pewter|heather/.test(n)) return 'Grey';
    if (/red|maroon|wine|cardinal|burgundy/.test(n)) return 'Red';
    if (/green|forest|hunter|kelly|olive/.test(n)) return 'Green';
    return 'Other';
  }
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
  function pcs(n) { return n + (n === 1 ? ' pc' : ' pcs'); }
  function money(n) { return '$' + (+n).toFixed(2); }
  function slug(s) { return String(s).toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim(); }

  // photo for a style + color + side: exact color, then a color that shares the last word (Navy ↔ Sport Dark Navy)
  function photoFor(st, color, side) {
    var ps = (st.photos || []).filter(function (p) { return p.side === side; });
    if (!ps.length) return null;
    if (!color) return ps[0];
    var c = slug(color), last = c.split(' ').pop();
    return ps.filter(function (p) { return slug(p.color) === c; })[0]
      || ps.filter(function (p) { var pc = slug(p.color); return pc.split(' ').pop() === last || c.indexOf(pc) >= 0 || pc.indexOf(c) >= 0; })[0] || null;
  }
  function hexOf(st, color) { var c = (st.colors || []).filter(function (x) { return x.name === color; })[0]; return c ? c.hex : '#ffffff'; }
  function imgHtml(st, color) {
    var p = photoFor(st, color, 'front') || (color ? null : (st.photos || [])[0]);
    return p ? '<img src="' + esc(p.url) + '" alt="' + esc(st.name + (color ? ' in ' + color : '')) + '" loading="lazy">' : shapeSvg(st.type, hexOf(st, color || (st.colors[0] || {}).name));
  }

  var DATA = null, STYLES = [], byCode = {};
  var F = { type: [], fit: [], mat: [], fam: [], open: null };
  var O = { reorder: false, reorderNo: '', step: 1, lines: [], deco: null, logo: null, logoType: null, inks: 1, placement: 'lc', sleeves: 0, otherText: '', otherSpots: ['small'], nextId: 1, quote: null, upsell: null, checkout: false };
  var SIZES = [['XS', 'std'], ['S', 'std'], ['M', 'std'], ['L', 'std'], ['XL', 'std'], ['2XL', 'x2'], ['3XL', 'x3']];
  var NAMES = { silk: 'Silk Screen', dtf: 'DTF Full-Color Print', emb: 'Embroidery' };
  var PLACES = [['lc', 'Left chest'], ['lcb', 'Left chest + Full back'], ['ff', 'Full front'], ['bk', 'Full back'], ['fb', 'Front + back'], ['other', 'Other']];

  // ── routing: #order opens the order flow; #order/TT11 starts it with that style ──
  function route() {
    var h = location.hash.replace(/^#/, '');
    if (h.indexOf('order') === 0) {
      var code = decodeURIComponent(h.split('/')[1] || '');
      if (code && byCode[code] && !O.lines.some(function (l) { return l.code === code; })) addLine(code);
      renderOrder();
    } else renderCatalog();
    window.scrollTo(0, root.offsetTop - 10);
  }
  window.addEventListener('hashchange', route);

  function heroHtml(order) {
    return '<div class="ww-crumb"><a href="/">Home</a> › ' + (order ? '<a href="#">Workwear &amp; Apparel</a> &rsaquo; Order custom shirts' : 'Workwear &amp; Apparel') + '</div>'
      + '<span class="ww-tag">' + (order ? 'Order custom shirts' : 'Workwear &amp; Apparel') + '</span>'
