    STYLES.forEach(function (s) { s.name = s.name.split(' ').filter(function (w) { return w.toUpperCase() !== s.code.toUpperCase(); }).join(' '); byCode[s.code] = s; });
    var editRef = (location.search.match(/[?&]edit=([0-9a-f]{10})/) || [])[1];
    (editRef ? loadEdit(editRef) : Promise.resolve(false)).then(function (edited) {
      if (!edited) loadState();
      if (edited) { if (history.replaceState) history.replaceState(null, '', location.pathname + '#order'); else location.hash = 'order'; O.step = 1; }   // editing starts at "Pick your shirts"
      route();
      if (O.lines.length && location.hash.indexOf('order') === 0) { O.step = Math.max(1, Math.min(O.step || 1, maxStep())); renderOrder(); }
    });
  }).catch(function () { app.innerHTML = '<div class="ww-empty">We couldn\'t load the styles right now. Please refresh the page or message us on WhatsApp.</div>'; });
})();
</script>
