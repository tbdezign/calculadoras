  }

  function renderAside() {
    var a = document.getElementById('ww-aside'); if (!a) return;
    var m = method(), t = total(), q = O.quote;
    var h = '<h3>Your order</h3>';
    if (!O.lines.length) h += '<div style="font-size:13px;color:#4b5563">No shirts yet.</div>';
    O.lines.forEach(function (l) { h += '<div class="ww-sline"><span>' + esc(byCode[l.code].name) + ' · ' + esc(l.color) + '</span><b style="white-space:nowrap">' + pcs(qtyOf(l)) + '</b></div>'; });
    var place = (PLACES.filter(function (x) { return x[0] === O.placement; })[0] || [])[1] + (O.placement === 'other' ? ' · ' + O.otherSpots.length + (O.otherSpots.length === 1 ? ' spot' : ' spots') : '') + (O.sleeves ? ' + ' + O.sleeves + (O.sleeves === 1 ? ' sleeve' : ' sleeves') : '');
    h += '<div class="ww-row" style="margin-top:10px"><span>Total pieces</span><b>' + t + '</b></div>'
      + '<div class="ww-row"><span>Method</span><b>' + (m ? NAMES[m] : '—') + '</b></div>'
      + (O.step >= 4 ? '<div class="ww-row"><span>Logo</span><b>' + esc(place) + '</b></div>' : '')
      + '<div class="ww-row"><span>Per piece</span><b>' + (q && q.total ? money(q.subtotal / q.total) + ' avg' : '—') + '</b></div>'
      + (m ? '<div class="ww-row"><span>Production</span><b>' + DATA.days[m][0] + '–' + DATA.days[m][1] + ' business days</b></div>' : '')
