<style>
  .ww * { box-sizing: border-box; }
  .ww { font-family: 'Poppins', 'Helvetica Neue', sans-serif; color: #051024; -webkit-font-smoothing: antialiased; background: #f7f7f7; }
  .ww button { font-family: inherit; cursor: pointer; }
  .ww button:disabled { cursor: default; opacity: .45; }
  .ww a { color: #1a7698; }
  .ww-hero-wrap { background: #fff; border-bottom: 1px solid #e2e2e2; padding: 0 5vw; }
  .ww-hero { padding: 28px 0 34px; max-width: 1640px; margin: 0 auto; }
  .ww-crumb { font-size: 13px; color: #6b7280; margin-bottom: 18px; }
  .ww-crumb a { color: #051024; text-decoration: none; }
  .ww-crumb a:hover { text-decoration: underline; }
  .ww-tag { font-family: 'Montserrat', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #749a37; background: #f2f8e8; border: 1px solid #c8e49a; padding: 5px 16px; border-radius: 20px; display: inline-block; margin-bottom: 20px; }
  .ww-h1 { font-family: 'Montserrat', 'Helvetica Neue', sans-serif; font-size: clamp(28px, 3.5vw, 40px); font-weight: 700; line-height: 1.1; letter-spacing: -.025em; margin: 0 0 14px; }
  .ww-h1 em { font-style: italic; color: #41a9cc; font-weight: 400; }
  .ww-sub { font-size: 15px; font-weight: 300; color: #6b7280; line-height: 1.7; margin: 0 0 20px; max-width: 760px; }
  .ww-trust { display: flex; flex-wrap: wrap; gap: 10px 22px; }
  .ww-trust span { font-family: 'Montserrat', sans-serif; font-size: 12px; font-weight: 600; display: flex; align-items: center; gap: 6px; }
  .ww-trust span::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: #91bc4d; }
  .ww-main { max-width: 1640px; margin: 0 auto; padding: 24px 5vw 56px; }
  @media (min-width: 1800px) { .ww-main { padding-left: 0; padding-right: 0; } }

  /* filters */
  .ww-filters { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 16px; }
  .ww-dd { position: relative; }
  .ww-ddbtn { display: inline-flex; align-items: center; gap: 8px; padding: 9px 14px; border-radius: 10px; border: 1.5px solid #d6dbe1; background: #fff; color: #051024; font-size: 14px; font-weight: 500; }
  .ww-ddbtn.on { background: #051024; color: #fff; border-color: #051024; }
  .ww-menu { position: absolute; top: calc(100% + 6px); left: 0; z-index: 20; min-width: 220px; background: #fff; border: 1px solid #e6e8ec; border-radius: 12px; box-shadow: 0 10px 30px rgba(5,16,36,.12); padding: 8px; }
  .ww-opt { display: flex; align-items: center; gap: 10px; width: 100%; padding: 10px; border: none; border-radius: 8px; background: #fff; color: #051024; font-size: 14px; text-align: left; }
  .ww-opt.on { background: #f3f8ea; }
  .ww-box { width: 18px; height: 18px; flex: none; border-radius: 4px; border: 1.5px solid #c9d1da; display: inline-flex; align-items: center; justify-content: center; color: #fff; font-size: 12px; font-weight: 700; }
  .ww-opt.on .ww-box { background: #051024; border-color: #051024; }
  .ww-box.dot { border-radius: 50%; }
  .ww-opt.on .ww-box.dot { border-color: #1a7698; box-shadow: 0 0 0 2px #fff inset; }
  .ww-count { font-size: 14px; color: #4b5563; }
  .ww-link { border: none; background: none; color: #1a7698; font-size: 14px; font-weight: 600; padding: 8px; }

  /* catalog grid */
  .ww-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 16px; }
  .ww-card { background: #fff; border: 1px solid #e2e2e2; border-radius: 14px; overflow: hidden; display: flex; flex-direction: column; transition: box-shadow .2s, transform .2s; }
  .ww-card:hover { box-shadow: 0 4px 20px rgba(5,16,36,.08); transform: translateY(-2px); }
  .ww-img { background: #fff; aspect-ratio: 1; display: flex; align-items: center; justify-content: center; overflow: hidden; position: relative; }
  .ww-img img { width: 92%; height: 92%; object-fit: contain; display: block; }
  .ww-card .ww-img { border-bottom: 1px solid #f0f0f0; }
  .ww-img svg { width: 62%; height: 62%; }
  .ww-best { position: absolute; top: 8px; left: 8px; z-index: 1; font-size: 11px; font-weight: 500; line-height: 1.3; color: #4b5563; background: rgba(255,255,255,.92); border: 1px solid #e5e7eb; border-radius: 999px; padding: 2px 8px; pointer-events: none; }
  .ww-best b { font-weight: 600; color: #051024; }
  .ww-mcard .ww-best { font-size: 10px; padding: 1px 7px; top: 6px; left: 6px; white-space: nowrap; }
  .ww-cbody { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .ww-badges { display: flex; flex-wrap: wrap; gap: 6px; }
  .ww-badge { font-size: 10.5px; font-weight: 600; letter-spacing: .8px; text-transform: uppercase; border-radius: 4px; padding: 3px 8px; }
  .ww-cname { font-family: 'Montserrat', sans-serif; font-size: 14px; font-weight: 700; line-height: 1.35; margin: 0; }
  .ww-dots { display: flex; gap: 5px; flex-wrap: wrap; align-items: center; }
  .ww-dots span.d { width: 16px; height: 16px; border-radius: 50%; border: 1px solid #c9d1da; }
  .ww-dots small { font-size: 12px; color: #4b5563; }
  .ww-from { font-size: 14px; color: #4b5563; margin-top: auto; }
  .ww-from b { color: #051024; font-size: 17px; }
  .ww-cta { display: flex; align-items: center; justify-content: center; gap: 6px; width: 100%; padding: 9px 10px; border-radius: 999px; border: 1.5px solid #051024; background: #fff; color: #051024 !important; text-decoration: none; font-weight: 600; font-size: 13px; white-space: nowrap; transition: background .15s, color .15s; }
  .ww-cta::after { content: "→"; transition: transform .15s; }
  .ww-cta:hover, .ww-card:hover .ww-cta { background: #051024; color: #fff !important; }
  .ww-card:hover .ww-cta::after { transform: translateX(3px); }
  .ww-note { font-size: 12px; color: #4b5563; margin: 16px 0 0; }
  .ww-empty { background: #fff; border: 1px dashed #c9d1da; border-radius: 14px; padding: 32px; text-align: center; color: #4b5563; font-size: 15px; }

  /* order flow */
  .ww-steps { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 22px; }
  .ww-step { display: flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 999px; border: 1px solid #d6dbe1; background: #fff; color: #051024; font-size: 13px; font-weight: 500; }
  .ww-step i { width: 22px; height: 22px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 600; font-style: normal; background: #eef1f4; color: #4b5563; }
  .ww-steps .ww-sep { align-self: center; color: #9ca3af; font-size: 14px; }
  .ww-step.cur { background: #051024; color: #fff; border-color: #051024; }
  .ww-step.cur i { background: #41a9cc; color: #fff; }
  .ww-step.done i { background: #91bc4d; color: #fff; }
  .ww-cols { display: flex; flex-wrap: wrap; gap: 24px; align-items: flex-start; }
  .ww-panel { flex: 999 1 560px; min-width: 0; background: #fff; border: 1px solid #e6e8ec; border-radius: 18px; padding: 28px; }
  .ww-aside { flex: 1 1 280px; min-width: 0; background: #fff; border: 1px solid #e6e8ec; border-radius: 18px; padding: 22px; position: sticky; top: 16px; }
  .ww-h2 { font-family: 'Montserrat', sans-serif; font-size: 22px; font-weight: 700; letter-spacing: -.2px; margin: 0 0 4px; }
  .ww-p { margin: 0 0 18px; color: #4b5563; font-size: 14px; }
  .ww-q { font-weight: 600; font-size: 15px; margin: 18px 0 10px; }
  .ww-mini { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; margin-bottom: 22px; }
  .ww-mcard { border: 1px solid #e3e3e3; border-radius: 12px; padding: 10px; display: flex; flex-direction: column; gap: 6px; background: #fff; text-align: left; }
  .ww-mcard .ww-img { border-radius: 8px; }
  .ww-mcard b { font-size: 13px; line-height: 1.3; font-weight: 600; }
  .ww-mcard small { font-size: 12px; color: #4b5563; }
  .ww-more { border-style: dashed; justify-content: center; align-items: center; text-align: center; background: #fafbfc; }
  .ww-more .ww-link { font-size: 13px; text-decoration: underline; }
  /* styles slider: swipe on phones/trackpads, drag or arrows with a mouse */
  .ww-slider { position: relative; margin-bottom: 22px; }
  .ww-track { display: flex; gap: 10px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; overscroll-behavior-x: contain; padding: 2px 2px 12px; scrollbar-width: thin; scrollbar-color: #c9d1da transparent; }
  .ww-track::-webkit-scrollbar { height: 6px; }
  .ww-track::-webkit-scrollbar-thumb { background: #c9d1da; border-radius: 3px; }
  .ww-track .ww-mcard { flex: 0 0 calc((100% - 30px) / 4); scroll-snap-align: start; }
  .ww-track.drag { scroll-snap-type: none; scroll-behavior: auto; cursor: grabbing; user-select: none; }
  .ww-track.drag * { pointer-events: none; }
  .ww-track img { -webkit-user-drag: none; user-select: none; }
  .ww-arrow { position: absolute; top: calc(50% - 26px); width: 38px; height: 38px; border-radius: 50%; border: 1px solid #e3e3e3; background: #fff; color: #051024; font-size: 22px; line-height: 1; box-shadow: 0 2px 8px rgba(5,16,36,.12); z-index: 2; display: flex; align-items: center; justify-content: center; padding: 0 0 3px; }
  .ww-arrow:hover { border-color: #1a7698; color: #1a7698; }
  .ww-arrow.prev { left: -16px; } .ww-arrow.next { right: -16px; }
  .ww-arrow[hidden] { display: none; }
  @media (hover: none) { .ww-arrow { display: none; } }
  .ww-addstyle { display: block; width: 100%; margin: 4px 0 6px; padding: 14px; border: 1.5px dashed #c9d1da; border-radius: 12px; background: #fafbfc; color: #051024; font-weight: 600; font-size: 14px; }
  .ww-addstyle:hover { border-color: #1a7698; color: #1a7698; }
  .ww-add { margin-top: auto; padding: 8px; border-radius: 8px; border: 1.5px solid #051024; background: #fff; color: #051024; font-weight: 600; font-size: 13px; }
  .ww-add:hover { background: #051024; color: #fff; }
  .ww-line { border: 1px solid #e3e3e3; border-radius: 12px; padding: 16px; margin-bottom: 12px; display: flex; gap: 18px; align-items: stretch; }
  /* the photo box is as tall as the line */
  .ww-lpic { flex: 0 0 250px; min-height: 220px; border: 0; padding: 0; margin: 0; box-shadow: none; outline: none; border-radius: 10px; background: #fff; display: flex; align-items: center; justify-content: center; cursor: zoom-in; overflow: hidden; }
  .ww-lpic img { width: 100%; height: 100%; object-fit: contain; }
  .ww-lpic svg { width: 78%; height: 78%; }
  /* line photo gallery: front / back / side of the chosen color */
  .ww-gal { position: relative; cursor: default; display: block; }
  .ww-gtrack { display: flex; width: 100%; height: 100%; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; scrollbar-width: none; }
  .ww-gtrack::-webkit-scrollbar { display: none; }
  .ww-gslide { flex: 0 0 100%; scroll-snap-align: center; border: 0; padding: 0; background: #fff; cursor: zoom-in; display: flex; align-items: center; justify-content: center; }
  .ww-gslide img { width: 100%; height: 100%; object-fit: contain; }
  .ww-garr { position: absolute; top: calc(50% - 15px); width: 30px; height: 30px; border-radius: 50%; border: 1px solid #e3e3e3; background: rgba(255,255,255,.95); color: #051024; font-size: 18px; line-height: 1; display: flex; align-items: center; justify-content: center; padding: 0 0 2px; z-index: 2; box-shadow: 0 1px 4px rgba(5,16,36,.12); }
  .ww-garr.prev { left: 6px; } .ww-garr.next { right: 6px; } .ww-garr[hidden] { display: none; }
  .ww-gdots { position: absolute; bottom: 6px; left: 0; right: 0; display: flex; justify-content: center; gap: 5px; pointer-events: none; }
  .ww-gdots span { width: 6px; height: 6px; border-radius: 50%; background: #cfd5dc; }
  .ww-gdots span.on { background: #051024; }
  .ww-gside { position: absolute; top: 8px; left: 8px; font-size: 11px; font-weight: 600; color: #4b5563; background: rgba(255,255,255,.9); border: 1px solid #e5e7eb; border-radius: 999px; padding: 1px 8px; pointer-events: none; }
  .ww-lpic:focus-visible { outline: 2px solid #2a9fd6; outline-offset: 2px; }
  .ww-lbody { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: space-between; gap: 14px; }
  .ww-lsec { display: flex; flex-direction: column; gap: 8px; }
  .ww-lab { font-size: 12px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: #6b7280; }
  .ww-lhead { display: flex; justify-content: space-between; align-items: center; gap: 6px 12px; flex-wrap: wrap; }
  .ww-lhead > div { display: flex; align-items: center; gap: 10px; min-width: 0; }
  /* the line's links always sit on their own row under the name and price, whatever the name length */
  .ww-line .ww-lhead { display: block; }
  .ww-llinks { display: flex; flex-wrap: wrap; gap: 4px 0; margin: 8px 0 0 -12px; }
  .ww-thumb { width: 48px; height: 48px; flex: none; border-radius: 8px; background: #fff; border: 1px solid #eee; overflow: hidden; display: flex; align-items: center; justify-content: center; }
  .ww-thumb img { width: 100%; height: 100%; object-fit: contain; }
  .ww-thumb svg { width: 80%; height: 80%; }
  .ww-sw { display: flex; flex-wrap: wrap; gap: 8px; }
  .ww-sw button { width: 30px; height: 30px; border-radius: 50%; border: 2px solid #d6dbe1; box-shadow: inset 0 0 0 2px #fff; padding: 0; }
  .ww-sw button.on { border-color: #1a7698; }
  .ww-sizes { display: grid; grid-template-columns: repeat(auto-fill, minmax(104px, 1fr)); gap: 8px; }
  .ww-size { border: 1px solid #e3e3e3; border-radius: 8px; padding: 6px; text-align: center; display: flex; flex-direction: column; justify-content: space-between; }
  .ww-size label { display: block; font-size: 12px; color: #4b5563; margin-bottom: 4px; }
  .ww-size label small { display: block; font-size: 11px; color: #1a7698; font-weight: 600; line-height: 1.2; }
  .ww-review { display: flex; gap: 12px; align-items: flex-start; background: #f2f8ec; border: 1px solid #d6e8c4; border-radius: 12px; padding: 12px 14px; margin-top: 16px; font-size: 14px; line-height: 1.5; color: #1f2937; }
  .ww-review svg { flex: none; width: 26px; height: 26px; color: #5f8f2a; margin-top: 1px; }
  .ww-review b { color: #051024; }
  .ww-size div { display: flex; align-items: center; justify-content: space-between; gap: 2px; }
  .ww-size button { width: 28px; height: 28px; border-radius: 6px; border: 1px solid #d6dbe1; background: #fff; color: #051024; -webkit-appearance: none; appearance: none; font-size: 16px; line-height: 1; padding: 0; flex: none; }
  .ww-size input { width: 100%; min-width: 0; border: none; text-align: center; font-weight: 600; font-size: 16px; color: #051024; font-family: inherit; background: transparent; -moz-appearance: textfield; padding: 0; }
  .ww-size input::-webkit-outer-spin-button, .ww-size input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .ww-dash { border: 1.5px dashed #c9d1da; border-radius: 12px; padding: 20px; text-align: center; color: #4b5563; font-size: 14px; }
  .ww-choice { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; }
  .ww-ch { text-align: left; padding: 14px 16px; border-radius: 14px; border: 2px solid #e3e3e3; background: #fff; color: #051024; }
  .ww-ch.on { border-color: #1a7698; background: #f5fafc; }
  .ww-ch b { display: block; font-size: 15px; margin-bottom: 3px; }
  .ww-ch span { font-size: 13px; color: #4b5563; }
  .ww-ch .ww-swatch { height: 46px; border-radius: 8px; margin-bottom: 10px; }
  .ww-choice > .ww-ch { display: flex; flex-direction: column; align-items: stretch; }
  .ww-choice > .ww-ch .ww-chfrom { margin-top: auto; padding-top: 10px; }
  .ww-choice > .ww-ch > .ww-pop { align-self: flex-start; }
  .ww-ch .ww-chimgw { position: relative; display: block; }
  .ww-ch .ww-chimgw .ww-pop { position: absolute; top: 10px; left: 10px; margin: 0; box-shadow: 0 1px 4px rgba(0,0,0,.15); }
  .ww-ch .ww-chimg { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 10px; margin-bottom: 10px; background: #f3f4f6; }
  .ww-sort { margin-left: auto; height: 38px; border: 1px solid #e3e3e3; border-radius: 10px; background: #fff; padding: 0 10px; font: inherit; font-size: 13.5px; color: #051024; cursor: pointer; }
  .ww-specs { margin: 8px 0 0; padding-left: 18px; font-size: 14px; line-height: 1.7; color: #1f2937; text-align: left; }
  .ww-spec1 { color: #4b5563; }
  .ww-note-in { width: 100%; box-sizing: border-box; min-height: 64px; border: 1px solid #d9dee5; border-radius: 10px; padding: 10px 12px; font: inherit; font-size: 14px; resize: vertical; }
  .ww-ch .ww-pop { display: inline-block; font-size: 10.5px; font-weight: 600; letter-spacing: .8px; text-transform: uppercase; color: #4f7a1f; background: #eef6e2; border-radius: 4px; padding: 3px 9px; margin-bottom: 6px; }
  .ww-pills { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .ww-pill { padding: 9px 16px; border-radius: 999px; border: 1.5px solid #d6dbe1; background: #fff; color: #051024; font-weight: 600; font-size: 14px; }
  .ww-pill.on { background: #051024; border-color: #051024; color: #fff; }
  .ww-upload { width: 100%; padding: 22px; border-radius: 12px; border: 1.5px dashed #c9d1da; background: #fafbfc; color: #051024; font-size: 14px; display: flex; align-items: center; justify-content: center; gap: 12px; }
  .ww-upload.on { border-color: #1a7698; }
  .ww-upload img { max-height: 64px; max-width: 160px; object-fit: contain; padding: 6px; border-radius: 6px; background: #9aa3ad repeating-conic-gradient(#b8c0c8 0 25%, #9aa3ad 0 50%) 0 0 / 14px 14px; }
  .ww-dotc { display: inline-block; width: 14px; height: 14px; border-radius: 50%; border: 1px solid #c9d1da; vertical-align: -2px; margin-right: 3px; }
  .ww-msg.amber { border: 1.5px solid #e9b949; background: #fff8e6; color: #5c4400; }
  .ww-confirm { display: flex; gap: 10px; align-items: flex-start; margin-top: 10px; font-size: 14px; color: #051024; cursor: pointer; }
  .ww-confirm input { width: 20px; height: 20px; margin: 1px 0 0; flex: none; accent-color: #1a7698; }
  .ww-hint { font-size: 12px; color: #1a7698; margin: -4px 0 10px; }
  .ww-method { border-radius: 14px; background: #051024; color: #fff; padding: 18px 20px; margin-bottom: 14px; }
  .ww-method small { font-size: 12px; letter-spacing: 1px; text-transform: uppercase; color: #9fd3e6; }
  .ww-method b { display: block; font-family: 'Montserrat', sans-serif; font-size: 24px; margin: 2px 0 4px; }
  .ww-method p { font-size: 14px; color: #d5dee8; margin: 0; }
  .ww-method em { display: block; font-style: normal; font-size: 13px; color: #9fd3e6; margin-top: 8px; }
  .ww-msg { border-radius: 12px; padding: 12px 14px; font-size: 14px; margin-bottom: 14px; }
  .ww-up { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .ww-up .ww-pill { padding: 8px 14px; font-size: 13px; }
  .ww-quick { border: 1.5px solid #91bc4d; border-radius: 12px; padding: 14px; margin: -6px 0 16px; display: grid; gap: 14px; background: #fff; }
  .ww-qline + .ww-qline { border-top: 1px solid #f0f0f0; padding-top: 12px; }
  .ww-msg.green { border: 1.5px solid #91bc4d; background: #f3f8ea; }
  .ww-msg.grey { border: 1px solid #e3e3e3; background: #fafbfc; }
  .ww-msg.red { border: 1px solid #f3c9c9; background: #fdf2f2; color: #8a1c1c; }
  .ww-ta { width: 100%; padding: 12px; border-radius: 10px; border: 1.5px solid #c9d1da; font-family: inherit; font-size: 16px; resize: vertical; }
  .ww-spot { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; padding: 10px 12px; border: 1px solid #e3e3e3; border-radius: 10px; margin-bottom: 8px; }
  .ww-spot > b { font-size: 14px; min-width: 96px; }
  .ww-spot .ww-pill { padding: 7px 12px; font-size: 13px; }
  .ww-drop { display: flex; gap: 14px; align-items: flex-start; }
  .ww-dropimg { flex: none; width: 120px; height: 120px; border-radius: 10px; border: 1px solid #e3e3e3; display: flex; align-items: center; justify-content: center; padding: 10px; box-sizing: border-box; }
  .ww-dropimg img { max-width: 100%; max-height: 100%; object-fit: contain; }
  @media (max-width: 560px) { .ww-drop { flex-direction: column; } }
  .ww-chfrom { margin-top: 10px; font-size: 13px; color: #4b5563; }
  .ww-chfrom strong { color: #051024; font-size: 15px; }
  .ww-save { display: grid; gap: 10px; justify-items: start; }
  .ww-save small { font-size: 12.5px; color: #4b5563; }
  .ww-xup { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border: 1.5px dashed #c9d1da; border-radius: 999px; font-size: 13px; cursor: pointer; background: #fafbfc; max-width: 100%; }
  .ww-xup.on { border-style: solid; border-color: #1a7698; }
  .ww-xup span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 180px; }
  .ww-xup img { height: 26px; max-width: 60px; object-fit: contain; border-radius: 4px; background: #9aa3ad repeating-conic-gradient(#b8c0c8 0 25%, #9aa3ad 0 50%) 0 0 / 10px 10px; }
  .ww-prevs { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; }
  .ww-prev { border: 1px solid #e3e3e3; border-radius: 12px; padding: 12px; text-align: center; }
  .ww-pimg { position: relative; aspect-ratio: 1; background: #fff; border-radius: 8px; overflow: hidden; }
  .ww-pimg > img, .ww-pimg > svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .ww-logo { position: absolute; display: flex; align-items: center; justify-content: center; }
  .ww-logo img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .ww-logo span { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 10px; border-radius: 3px; }
  .ww-pimg { cursor: zoom-in; }
  .ww-zoom { position: fixed; inset: 0; z-index: 9999; background: rgba(5,16,36,.82); display: flex; align-items: center; justify-content: center; padding: 16px; cursor: zoom-out; }
  .ww-zoom .ww-pimg { width: min(92vw, 88vh, 900px); cursor: zoom-out; border-radius: 12px; }
  .ww-zoom .ww-logo span { font-size: 22px; }
  .ww-chart { background: #fff; border-radius: 12px; padding: 16px; max-width: min(92vw, 900px); max-height: 88vh; overflow: auto; text-align: center; }
  .ww-chart b { display: block; font-family: 'Montserrat', sans-serif; font-size: 15px; margin-bottom: 10px; }
  .ww-chart img { max-width: 100%; height: auto; }
  .ww-chart { cursor: default; }
  /* reviews (Doran, per style) */
  .ww-stars { position: relative; display: inline-block; font-size: 13px; line-height: 1; letter-spacing: 1px; color: #d7dbe0; white-space: nowrap; }
  .ww-stars i { position: absolute; left: 0; top: 0; overflow: hidden; color: #f5a623; font-style: normal; white-space: nowrap; }
  .ww-rate { display: inline-flex; align-items: center; gap: 6px; border: 0; background: none; padding: 0; font-size: 12.5px; color: #4b5563; cursor: pointer; text-align: left; }
  .ww-rate b { color: #051024; font-weight: 600; }
  .ww-rate:hover u { color: #1a7698; }
  .ww-trust .ww-trate::before, .ww-trust span span::before { display: none; }
  .ww-trate { color: #051024; }
  .ww-revs { background: #fff; border-radius: 14px; padding: 22px 22px 8px; width: min(92vw, 640px); max-height: 86vh; overflow: auto; text-align: left; cursor: default; }
  .ww-revs h3 { font-family: 'Montserrat', sans-serif; font-size: 18px; margin: 0 0 6px; }
  .ww-revsum { display: flex; align-items: center; gap: 10px; padding-bottom: 14px; border-bottom: 1px solid #eef0f3; font-size: 14px; color: #4b5563; }
  .ww-revsum .big { font-family: 'Montserrat', sans-serif; font-size: 30px; font-weight: 800; color: #051024; }
  .ww-revsum .ww-stars { font-size: 18px; }
  .ww-rev { padding: 14px 0; border-bottom: 1px solid #eef0f3; }
  .ww-rev:last-child { border-bottom: 0; }
  .ww-rev-h { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 13px; color: #6b7280; }
  .ww-rev-h b { color: #051024; font-weight: 600; }
  .ww-rev-v { color: #56751f; font-size: 11.5px; }
  .ww-rev p { margin: 6px 0 0; font-size: 14px; line-height: 1.55; color: #1f2937; }
  .ww-rev .t { font-weight: 600; color: #051024; }
  .ww-rev-pics { display: flex; gap: 6px; margin-top: 8px; flex-wrap: wrap; }
  .ww-rev-pics img { width: 64px; height: 64px; object-fit: cover; border-radius: 8px; border: 1px solid #eee; }
  .ww-tbl { overflow-x: auto; }
  .ww-tbl table { border-collapse: collapse; font-size: 14px; min-width: 100%; }
  .ww-tbl th, .ww-tbl td { padding: 9px 12px; text-align: center; border-bottom: 1px solid #eceef1; white-space: nowrap; }
  .ww-tbl thead th { background: #051024; color: #fff; font-family: 'Montserrat', sans-serif; font-size: 13px; }
  .ww-tbl tbody th { text-align: left; font-weight: 600; color: #051024; position: sticky; left: 0; background: #fff; }
  .ww-tbl tbody tr:nth-child(even) td, .ww-tbl tbody tr:nth-child(even) th { background: #f7f8fa; }
  .ww-tnote { display: block; margin-top: 10px; color: #6b7280; font-size: 12px; text-align: left; }
  .ww-zoom-x { position: absolute; top: 14px; right: 18px; color: #fff; font-size: 34px; line-height: 1; background: none; border: none; }
  .ww-prev b { display: block; font-size: 13px; margin-top: 8px; }
  .ww-prev small { display: block; font-size: 12px; color: #4b5563; }
  .ww-nav { display: flex; justify-content: space-between; gap: 12px; margin-top: 26px; flex-wrap: wrap; }
  .ww-btn { padding: 12px 24px; border-radius: 10px; border: none; background: #051024; color: #fff; font-weight: 600; font-size: 14px; }
  .ww-btn.ghost { border: 1.5px solid #c9d1da; background: #fff; color: #051024; }
  .ww-btn.pay { background: #1a7698; }
  .ww-aside h3 { font-family: 'Montserrat', sans-serif; font-size: 17px; margin: 0 0 12px; }
  .ww-row { display: flex; justify-content: space-between; gap: 10px; font-size: 14px; margin-top: 6px; }
  .ww-row b { text-align: right; }
  .ww-sline { display: flex; justify-content: space-between; gap: 10px; font-size: 13px; padding: 6px 0; border-bottom: 1px solid #f0f0f0; }
  .ww-total { display: flex; justify-content: space-between; align-items: baseline; font-size: 15px; margin-top: 14px; padding-top: 12px; border-top: 2px solid #051024; }
  .ww-total b { font-family: 'Montserrat', sans-serif; font-size: 24px; }
  .ww-fine { font-size: 12px; color: #4b5563; margin-top: 8px; }
  .ww-loading { padding: 40px; text-align: center; color: #6b7280; }
  @media (max-width: 768px) {
    .ww-panel { padding: 18px; }
    .ww-grid { grid-template-columns: 1fr 1fr; gap: 10px; }
    .ww-cbody { padding: 10px 12px 12px; }
    .ww-cname { font-size: 13px; }
    .ww-from { font-size: 12px; }
    .ww-from b { font-size: 15px; }
    .ww-cta { padding: 8px; }
    .ww-aside { position: static; }
    .ww-line { flex-direction: column; gap: 10px; }
    .ww-lpic { flex: none; width: 100%; max-width: 200px; min-height: 0; aspect-ratio: 1; align-self: center; }
    .ww-tbl table { font-size: 13px; }
    .ww-tbl th, .ww-tbl td { padding: 8px 9px; }
    .ww-tbl tbody th { white-space: normal; min-width: 96px; }
    .ww-chart { padding: 14px 10px; }
    .ww-mini { grid-template-columns: 1fr 1fr; }
    .ww-track .ww-mcard { flex-basis: 56%; }
    .ww-arrow { display: none; }
    .ww-steps { gap: 4px; }
    .ww-step { padding: 6px; }
    .ww-step:not(.cur) .ww-lbl { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .ww-step.cur { padding-right: 14px; }
    .ww-count { margin-left: 0; width: 100%; }
  }
</style>

<div class="ww" id="tbd-ww" data-api="{{ section.settings.api_url | escape }}"{% if section.settings.deco_print %} data-img-print="{{ section.settings.deco_print | image_url: width: 900 }}" data-pos-print="{{ section.settings.deco_print.presentation.focal_point }}"{% endif %}{% if section.settings.deco_emb %} data-img-emb="{{ section.settings.deco_emb | image_url: width: 900 }}" data-pos-emb="{{ section.settings.deco_emb.presentation.focal_point }}"{% endif %}>
  <div class="ww-hero-wrap"><div class="ww-hero" id="ww-hero"></div></div>
  <div class="ww-main" id="ww-app"><div class="ww-loading">Loading styles…</div></div>
</div>

{% raw %}
<script>
(function () {
  var root = document.getElementById('tbd-ww'); if (!root) return;
  var API = root.getAttribute('data-api');
  var hero = document.getElementById('ww-hero'), app = document.getElementById('ww-app');

  // ── shapes for styles without a photo ──
  var SHAPE = {
    'T-shirt': 'M35 12 L22 16 L8 30 L18 40 L26 34 L26 90 L74 90 L74 34 L82 40 L92 30 L78 16 L65 12 Q50 22 35 12 Z',
    'Long sleeve': 'M35 12 L22 16 L5 56 L15 60 L26 36 L26 90 L74 90 L74 36 L85 60 L95 56 L78 16 L65 12 Q50 22 35 12 Z',
    'Polo': 'M36 12 L22 16 L8 30 L18 40 L26 34 L26 90 L74 90 L74 34 L82 40 L92 30 L78 16 L64 12 L56 22 L50 34 L44 22 Z'
  };
  SHAPE['Scrub top'] = 'M34 12 L22 16 L8 30 L18 40 L26 34 L26 90 L74 90 L74 34 L82 40 L92 30 L78 16 L66 12 L50 38 Z';
  function shapeSvg(type, hex) { return '<svg viewBox="0 0 100 100" aria-hidden="true"><path d="' + (SHAPE[type] || SHAPE['T-shirt']) + '" fill="' + (hex || '#fff') + '" stroke="#c9d1da" stroke-width="1.2" stroke-linejoin="round"/></svg>'; }

  var MAT = { 'Performance': ['#1a5f78', '#e6f4f9'], '100% cotton': ['#4f7a1f', '#eef6e2'], 'Cotton blend': ['#6b4e1f', '#f7efe2'] };
  var FAMHEX = { White: '#ffffff', Black: '#1d1d1f', Navy: '#232c44', Blue: '#2554a6', Grey: '#9ea3a8', Red: '#b3202a', Green: '#24452f' };
  function fam(n) {
    n = String(n).toLowerCase();
    if (/white|natural/.test(n)) return 'White';
    if (/black/.test(n)) return 'Black';
    if (/navy/.test(n)) return 'Navy';
    if (/royal|blue|ceil|caribbean|sapphire|teal|aqua/.test(n)) return 'Blue';
    if (/grey|gray|graphite|silver|charcoal|pewter|heather/.test(n)) return 'Grey';
    if (/red|maroon|wine|cardinal|burgundy/.test(n)) return 'Red';
    if (/green|forest|hunter|kelly|olive/.test(n)) return 'Green';
    return 'Other';
  }
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
  function pcs(n) { return n + (n === 1 ? ' pc' : ' pcs'); }
  function money(n) { return '$' + (+n).toFixed(2); }
  function slug(s) { return String(s).toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim(); }

  // photo for a style + color + side: exact color, then a color that shares the last word (Navy ↔ Sport Dark Navy)
  function photoFor(st, color, side) {
    var ps = (st.photos || []).filter(function (p) { return p.side === side; });
    if (!ps.length) return null;
    if (!color) return ps[0];
    // exact color, or one name inside the other (Navy ↔ Sport Dark Navy). Never a different color with a shared word
    // (Safety Green must not show the Olive Green photo): then the drawing in the right color is shown instead.
    var c = slug(color);
    return ps.filter(function (p) { return slug(p.color) === c; })[0]
      || ps.filter(function (p) { var pc = slug(p.color); return (' ' + c + ' ').indexOf(' ' + pc + ' ') >= 0 || (' ' + pc + ' ').indexOf(' ' + c + ' ') >= 0; })[0] || null;
  }
  function hexOf(st, color) { var c = (st.colors || []).filter(function (x) { return x.name === color; })[0]; return c ? c.hex : '#ffffff'; }
  // order line picture: one photo, or a little gallery when the color has back / side photos too
  var SIDE_NAMES = { front: 'Front', back: 'Back', side: 'Side', rside: 'Right side' };
  function linePicHtml(st, l) {
    var pics = ['front', 'back', 'side', 'rside'].map(function (sd) { var p = photoFor(st, l.color, sd); return p ? [sd, p] : null; }).filter(Boolean);
    if (pics.length < 2) return '<button class="ww-lpic" data-zoompic="' + l.id + '" aria-label="See ' + esc(st.name) + ' in ' + esc(l.color) + ' bigger">' + imgHtml(st, l.color) + '</button>';
    return '<div class="ww-lpic ww-gal" data-gal>'
      + '<div class="ww-gtrack">' + pics.map(function (x) { return '<button class="ww-gslide" data-zoompic="' + l.id + '" data-zside="' + x[0] + '" aria-label="' + esc(st.name + ' in ' + l.color + ', ' + SIDE_NAMES[x[0]]) + ' bigger"><img src="' + esc(x[1].url) + '" alt="" loading="lazy"></button>'; }).join('') + '</div>'
      + '<button class="ww-garr prev" data-galstep="-1" aria-label="Previous photo" hidden>\u2039</button><button class="ww-garr next" data-galstep="1" aria-label="Next photo">\u203a</button>'
      + '<span class="ww-gside">Front</span><div class="ww-gdots">' + pics.map(function (x, i) { return '<span' + (i ? '' : ' class="on"') + ' data-side="' + x[0] + '"></span>'; }).join('') + '</div></div>';
  }
  function initGalleries(rootEl) {
    [].forEach.call(rootEl.querySelectorAll('[data-gal]'), function (g) {
      var tr = g.querySelector('.ww-gtrack'), dots = g.querySelectorAll('.ww-gdots span'), lab = g.querySelector('.ww-gside');
      var upd = function () {
        var i = Math.round(tr.scrollLeft / Math.max(1, tr.clientWidth));
        [].forEach.call(dots, function (d, k) { d.classList.toggle('on', k === i); });
        if (dots[i]) lab.textContent = SIDE_NAMES[dots[i].dataset.side];
        g.querySelector('.prev').hidden = i <= 0; g.querySelector('.next').hidden = i >= dots.length - 1;
      };
      tr.addEventListener('scroll', upd, { passive: true });
    });
  }
  // the choice's photo (theme settings), with the "Best for your shirts" badge on top of it so both cards line up
  function decoImg(k, badge) {
    var u = root.getAttribute('data-img-' + k); if (!u) return badge;
    var pos = (root.getAttribute('data-pos-' + k) || '').trim();   // focal point set in the theme editor (Edit image → focal point)
    return '<span class="ww-chimgw"><img class="ww-chimg"' + (/^[\d.]+% [\d.]+%$/.test(pos) ? ' style="object-position:' + pos + '"' : '') + ' src="' + esc(u) + '" alt="' + (k === 'emb' ? 'Embroidered logo close-up' : 'Printed logo close-up') + '" loading="lazy">' + badge + '</span>';
  }
  function specsOf(st) { return String(st.description || '').split(/\n|\s\/\s/).map(function (x) { return x.trim(); }).filter(Boolean); }
  function specsModal(st) {
    var d = [st.material, st.fit, st.type].filter(Boolean).join(' · ');
    return '<div class="ww-revs" onclick="event.stopPropagation()"><h3>' + esc(st.name) + '</h3>' + (d ? '<div style="font-size:13px;color:#6b7280">' + esc(d) + '</div>' : '')
      + '<ul class="ww-specs">' + specsOf(st).map(function (x) { return '<li>' + esc(x) + '</li>'; }).join('') + '</ul>'
      + (st.sizeChart || st.sizeTable ? '<p style="margin:12px 0 10px"><button class="ww-link" style="padding:0" onclick="this.closest(\'.ww-zoom\').remove();document.querySelector(\'[data-chart=&quot;' + esc(st.code) + '&quot;]\').click()">See the size chart</button></p>' : '<div style="height:10px"></div>') + '</div>';
  }
  function imgHtml(st, color) {
    // no color asked (catalog card): the first listed color that has a photo, never a color that isn't offered
    if (!color) { var withPic = st.colors.filter(function (c) { return photoFor(st, c.name, 'front'); })[0]; color = withPic ? withPic.name : null; }
    var p = photoFor(st, color, 'front');
    return p ? '<img src="' + esc(p.url) + '" alt="' + esc(st.name + (color ? ' in ' + color : '')) + '" loading="lazy">' : shapeSvg(st.type, hexOf(st, color || (st.colors[0] || {}).name));
  }

  var DATA = null, STYLES = [], byCode = {};
  var F = { type: [], fit: [], mat: [], fam: [], open: null, sort: '' };
  var O = { reorder: false, reorderNo: '', step: 1, lines: [], deco: null, logo: null, logoType: null, inks: 1, placement: 'lc', sleeves: 0, otherText: '', otherSpots: ['small'], sleeveSide: '', xlogo: {}, nextId: 1, quote: null, upsell: null, checkout: false };
  var SIZES = [['2XS', 'std'], ['XS', 'std'], ['S', 'std'], ['M', 'std'], ['L', 'std'], ['XL', 'std'], ['2XL', 'x2'], ['3XL', 'x3']];
  var NAMES = { silk: 'Silk Screen', dtf: 'DTF Full-Color Print', emb: 'Embroidery' };
  var PLACES = [['lc', 'Left chest'], ['lcb', 'Left chest + Full back'], ['ff', 'Full front'], ['bk', 'Full back'], ['fb', 'Front + back'], ['other', 'Other']];

  // ── routing: #order opens the order flow; #order/TT11 starts it with that style ──
  function route() {
    var h = location.hash.replace(/^#/, '');
    if (h === 'chat') return;   // the store's chat link (#chat): not a page of ours
    if (h.indexOf('order') === 0) {
      var code = decodeURIComponent(h.split('/')[1] || '');
      if (code && byCode[code] && !O.lines.some(function (l) { return l.code === code; })) addLine(code);
      renderOrder();
    } else renderCatalog();
    window.scrollTo(0, root.offsetTop - 10);
  }
  window.addEventListener('hashchange', route);

  // ── reviews: collected by Doran on each style's checkout product, sent with the catalog ──
  function starsHtml(avg) { var w = Math.max(0, Math.min(5, +avg || 0)) / 5 * 100; return '<span class="ww-stars" aria-hidden="true">★★★★★<i style="width:' + w.toFixed(0) + '%">★★★★★</i></span>'; }
  function rateHtml(s) {
    var r = s && s.rating; if (!r || !r.count) return '';
    return '<button class="ww-rate" data-reviews="' + esc(s.code) + '" aria-label="' + (+r.avg).toFixed(1) + ' out of 5, ' + r.count + ' reviews">' + starsHtml(r.avg) + '<b>' + (+r.avg).toFixed(1) + '</b><u>(' + r.count + ')</u></button>';
  }
  function reviewsModal(s) {
    var r = s.rating, list = (r.reviews || []).slice(0, 30);
    var dt = function (ms) { var d = new Date(+ms); return isNaN(d) ? '' : d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' }); };
    return '<div class="ww-revs" onclick="event.stopPropagation()"><h3>' + esc(s.name) + '</h3>'
      + '<div class="ww-revsum"><span class="big">' + (+r.avg).toFixed(1) + '</span><span>' + starsHtml(r.avg) + '<br>' + r.count + ' review' + (r.count === 1 ? '' : 's') + '</span></div>'
      + list.map(function (v) {
        return '<div class="ww-rev"><div class="ww-rev-h">' + starsHtml(v.stars) + '<b>' + esc(v.name || 'Customer') + '</b>' + (v.verified ? '<span class="ww-rev-v">✓ Verified buyer</span>' : '') + '<span>' + esc(dt(v.date)) + '</span></div>'
          + (v.title || v.text ? '<p>' + (v.title ? '<span class="t">' + esc(v.title) + '</span><br>' : '') + esc(v.text || '') + '</p>' : '')
          + (v.pics && v.pics.length ? '<div class="ww-rev-pics">' + v.pics.slice(0, 4).map(function (u) { return '<img src="' + esc(u) + '" alt="" loading="lazy">'; }).join('') + '</div>' : '')
          + '</div>';
      }).join('') + '</div>';
  }
  function heroHtml(order) {
    return '<div class="ww-crumb"><a href="/">Home</a> › ' + (order ? '<a href="#">Workwear &amp; Apparel</a> &rsaquo; Order custom shirts' : 'Workwear &amp; Apparel') + '</div>'
      + '<span class="ww-tag">' + (order ? 'Order custom shirts' : 'Workwear &amp; Apparel') + '</span>'
      + (order ? '<h1 class="ww-h1">Your team, your logo<br><em>ready in a few clicks.</em></h1><p class="ww-sub">Pick your shirts and upload your logo. We choose the best print method for your order and show your price right away.</p>'
               : '<h1 class="ww-h1">Branded workwear<br><em>your team will actually wear.</em></h1><p class="ww-sub">Pick a style, add your logo and see your price right away. Printed or embroidered, we choose the best method for your order.</p>')
      + '<div class="ww-trust">' + (DATA.reviews && DATA.reviews.count ? '<span class="ww-trate">' + starsHtml(DATA.reviews.avg) + ' <b>' + (+DATA.reviews.avg).toFixed(1) + '</b>&nbsp;· ' + DATA.reviews.count + ' customer reviews</span>' : '') + '<span>Mix styles &amp; colors</span><span>From ' + DATA.minimums.dtf + ' pieces</span><span>Free shipping</span><span>Every file checked by our team</span><span>Free proof before printing</span></div>';
  }

  // ════════ CATALOG ════════
  var FDEF = [
    { key: 'type', title: 'Style', opts: [['T-shirt', 'T-shirts'], ['Long sleeve', 'Long sleeve'], ['Polo', 'Polos'], ['Scrub top', 'Scrub tops'], ['Hoodie', 'Hoodies']] },
    { key: 'fit', title: 'Fit', opts: [["Men's", "Men's"], ["Women's", "Women's"], ['Unisex', 'Unisex'], ['Youth', 'Youth']] },
    { key: 'mat', title: 'Material', opts: [['Performance', 'Performance', 'moisture-wicking'], ['100% cotton', '100% cotton'], ['Cotton blend', 'Cotton blend']] },
    { key: 'fam', title: 'Color', color: true, opts: Object.keys(FAMHEX).map(function (k) { return [k, k]; }) }
  ];
  function filtered() {
    return STYLES.filter(function (s) {
      if (F.type.length && F.type.indexOf(s.type) < 0) return false;
      if (F.fit.length && F.fit.indexOf(s.fit) < 0) return false;
      if (F.mat.length && F.mat.indexOf(s.material) < 0) return false;
      if (F.fam.length && !s.colors.some(function (c) { return F.fam.indexOf(fam(c.name)) >= 0; })) return false;
      return true;
    });
  }
  function renderCatalog() {
    hero.innerHTML = heroHtml(false);
    var list = filtered(), any = F.type.length + F.fit.length + F.mat.length + F.fam.length;
    if (F.sort) list = list.slice().sort(function (a, b) { var x = a.from == null ? 1e9 : a.from, y = b.from == null ? 1e9 : b.from; return F.sort === 'low' ? x - y : y - x; });
    var h = '<div class="ww-filters">';
    FDEF.forEach(function (d) {
      // only offer options that exist in the catalog
      var opts = d.opts.filter(function (o) { return STYLES.some(function (s) { return d.key === 'type' ? s.type === o[0] : d.key === 'fit' ? s.fit === o[0] : d.key === 'mat' ? s.material === o[0] : s.colors.some(function (c) { return fam(c.name) === o[0]; }); }); });
      if (opts.length < 2) return;
      var sel = F[d.key], n = sel.length, names = opts.filter(function (o) { return sel.indexOf(o[0]) >= 0; }).map(function (o) { return o[1]; });
