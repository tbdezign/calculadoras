<div class="ww" id="tbd-ww" data-api="{{ section.settings.api_url | escape }}">
  <div class="ww-hero-wrap"><div class="ww-hero" id="ww-hero"></div></div>
  <div class="ww-main" id="ww-app"><div class="ww-loading">Loading styles…</div></div>
</div>

{% raw %}
<script>
(function () {
  var root = document.getElementById('tbd-ww'); if (!root) return;
  var API = root.getAttribute('data-api');
  var hero = document.getElementById('ww-hero'), app = document.getElementById('ww-app');

  // ── shapes for styles without a photo ──
  var SHAPE = {
    'T-shirt': 'M35 12 L22 16 L8 30 L18 40 L26 34 L26 90 L74 90 L74 34 L82 40 L92 30 L78 16 L65 12 Q50 22 35 12 Z',
    'Long sleeve': 'M35 12 L22 16 L5 56 L15 60 L26 36 L26 90 L74 90 L74 36 L85 60 L95 56 L78 16 L65 12 Q50 22 35 12 Z',
    'Polo': 'M36 12 L22 16 L8 30 L18 40 L26 34 L26 90 L74 90 L74 34 L82 40 L92 30 L78 16 L64 12 L56 22 L50 34 L44 22 Z'
  };
  SHAPE['Scrub top'] = 'M34 12 L22 16 L8 30 L18 40 L26 34 L26 90 L74 90 L74 34 L82 40 L92 30 L78 16 L66 12 L50 38 Z';
  function shapeSvg(type, hex) { return '<svg viewBox="0 0 100 100" aria-hidden="true"><path d="' + (SHAPE[type] || SHAPE['T-shirt']) + '" fill="' + (hex || '#fff') + '" stroke="#c9d1da" stroke-width="1.2" stroke-linejoin="round"/></svg>'; }

  var MAT = { 'Performance': ['#1a5f78', '#e6f4f9'], '100% cotton': ['#4f7a1f', '#eef6e2'], 'Cotton blend': ['#6b4e1f', '#f7efe2'] };
  var FAMHEX = { White: '#ffffff', Black: '#1d1d1f', Navy: '#232c44', Blue: '#2554a6', Grey: '#9ea3a8', Red: '#b3202a', Green: '#24452f' };
  function fam(n) {
    n = String(n).toLowerCase();
    if (/white|natural/.test(n)) return 'White';
    if (/black/.test(n)) return 'Black';
    if (/navy/.test(n)) return 'Navy';
    if (/royal|blue|ceil|caribbean|sapphire|teal|aqua/.test(n)) return 'Blue';
    if (/grey|gray|graphite|silver|charcoal|pewter|heather/.test(n)) return 'Grey';
    if (/red|maroon|wine|cardinal|burgundy/.test(n)) return 'Red';
    if (/green|forest|hunter|kelly|olive/.test(n)) return 'Green';
    return 'Other';
  }
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
  function pcs(n) { return n + (n === 1 ? ' pc' : ' pcs'); }
  function money(n) { return '$' + (+n).toFixed(2); }
  function slug(s) { return String(s).toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim(); }

  // photo for a style + color + side: exact color, then a color that shares the last word (Navy ↔ Sport Dark Navy)
  function photoFor(st, color, side) {
    var ps = (st.photos || []).filter(function (p) { return p.side === side; });
    if (!ps.length) return null;
    if (!color) return ps[0];
    // exact color, or one name inside the other (Navy ↔ Sport Dark Navy). Never a different color with a shared word
    // (Safety Green must not show the Olive Green photo): then the drawing in the right color is shown instead.
    var c = slug(color);
    return ps.filter(function (p) { return slug(p.color) === c; })[0]
      || ps.filter(function (p) { var pc = slug(p.color); return (' ' + c + ' ').indexOf(' ' + pc + ' ') >= 0 || (' ' + pc + ' ').indexOf(' ' + c + ' ') >= 0; })[0] || null;
  }
  function hexOf(st, color) { var c = (st.colors || []).filter(function (x) { return x.name === color; })[0]; return c ? c.hex : '#ffffff'; }
  function imgHtml(st, color) {
    var p = photoFor(st, color, 'front') || (color ? null : (st.photos || [])[0]);
    return p ? '<img src="' + esc(p.url) + '" alt="' + esc(st.name + (color ? ' in ' + color : '')) + '" loading="lazy">' : shapeSvg(st.type, hexOf(st, color || (st.colors[0] || {}).name));
  }

  var DATA = null, STYLES = [], byCode = {};
  var F = { type: [], fit: [], mat: [], fam: [], open: null };
  var O = { reorder: false, reorderNo: '', step: 1, lines: [], deco: null, logo: null, logoType: null, inks: 1, placement: 'lc', sleeves: 0, otherText: '', otherSpots: ['small'], xlogo: {}, nextId: 1, quote: null, upsell: null, checkout: false };
  var SIZES = [['2XS', 'std'], ['XS', 'std'], ['S', 'std'], ['M', 'std'], ['L', 'std'], ['XL', 'std'], ['2XL', 'x2'], ['3XL', 'x3']];
  var NAMES = { silk: 'Silk Screen', dtf: 'DTF Full-Color Print', emb: 'Embroidery' };
  var PLACES = [['lc', 'Left chest'], ['lcb', 'Left chest + Full back'], ['ff', 'Full front'], ['bk', 'Full back'], ['fb', 'Front + back'], ['other', 'Other']];

  // ── routing: #order opens the order flow; #order/TT11 starts it with that style ──
  function route() {
    var h = location.hash.replace(/^#/, '');
    if (h.indexOf('order') === 0) {
      var code = decodeURIComponent(h.split('/')[1] || '');
      if (code && byCode[code] && !O.lines.some(function (l) { return l.code === code; })) addLine(code);
      renderOrder();
    } else renderCatalog();
    window.scrollTo(0, root.offsetTop - 10);
  }
  window.addEventListener('hashchange', route);

  function heroHtml(order) {
    return '<div class="ww-crumb"><a href="/">Home</a> › ' + (order ? '<a href="#">Workwear &amp; Apparel</a> &rsaquo; Order custom shirts' : 'Workwear &amp; Apparel') + '</div>'
      + '<span class="ww-tag">' + (order ? 'Order custom shirts' : 'Workwear &amp; Apparel') + '</span>'
      + (order ? '<h1 class="ww-h1">Your team, your logo<br><em>ready in a few clicks.</em></h1><p class="ww-sub">Pick your shirts and upload your logo. We choose the best print method for your order and show your price right away.</p>'
               : '<h1 class="ww-h1">Branded workwear<br><em>your team will actually wear.</em></h1><p class="ww-sub">Pick a style, add your logo and see your price right away. Printed or embroidered, we choose the best method for your order.</p>')
      + '<div class="ww-trust"><span>Mix styles &amp; colors</span><span>From ' + DATA.minimums.dtf + ' pieces</span><span>Free shipping</span><span>Free proof before printing</span></div>';
  }

  // ════════ CATALOG ════════
  var FDEF = [
    { key: 'type', title: 'Style', opts: [['T-shirt', 'T-shirts'], ['Long sleeve', 'Long sleeve'], ['Polo', 'Polos'], ['Scrub top', 'Scrub tops'], ['Hoodie', 'Hoodies']] },
    { key: 'fit', title: 'Fit', opts: [["Men's", "Men's"], ["Women's", "Women's"], ['Unisex', 'Unisex'], ['Youth', 'Youth']] },
    { key: 'mat', title: 'Material', opts: [['Performance', 'Performance', 'moisture-wicking'], ['100% cotton', '100% cotton'], ['Cotton blend', 'Cotton blend']] },
    { key: 'fam', title: 'Color', color: true, opts: Object.keys(FAMHEX).map(function (k) { return [k, k]; }) }
  ];
  function filtered() {
    return STYLES.filter(function (s) {
      if (F.type.length && F.type.indexOf(s.type) < 0) return false;
      if (F.fit.length && F.fit.indexOf(s.fit) < 0) return false;
      if (F.mat.length && F.mat.indexOf(s.material) < 0) return false;
      if (F.fam.length && !s.colors.some(function (c) { return F.fam.indexOf(fam(c.name)) >= 0; })) return false;
      return true;
    });
  }
  function renderCatalog() {
    hero.innerHTML = heroHtml(false);
    var list = filtered(), any = F.type.length + F.fit.length + F.mat.length + F.fam.length;
    var h = '<div class="ww-filters">';
    FDEF.forEach(function (d) {
      // only offer options that exist in the catalog
      var opts = d.opts.filter(function (o) { return STYLES.some(function (s) { return d.key === 'type' ? s.type === o[0] : d.key === 'fit' ? s.fit === o[0] : d.key === 'mat' ? s.material === o[0] : s.colors.some(function (c) { return fam(c.name) === o[0]; }); }); });
      if (opts.length < 2) return;
      var sel = F[d.key], n = sel.length, names = opts.filter(function (o) { return sel.indexOf(o[0]) >= 0; }).map(function (o) { return o[1]; });
      h += '<div class="ww-dd"><button class="ww-ddbtn' + (n ? ' on' : '') + '" data-dd="' + d.key + '" aria-expanded="' + (F.open === d.key) + '">'
        + esc(n === 0 ? d.title : n === 1 ? d.title + ': ' + names[0] : d.title + ' (' + n + ')')
        + '<svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 L6 8 L9.5 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></button>';
      if (F.open === d.key) {
        h += '<div class="ww-menu">' + opts.map(function (o) {
          var on = sel.indexOf(o[0]) >= 0;
          return '<button class="ww-opt' + (on ? ' on' : '') + '" data-f="' + d.key + '" data-v="' + esc(o[0]) + '" aria-pressed="' + on + '">'
            + '<span class="ww-box' + (d.color ? ' dot' : '') + '"' + (d.color ? ' style="background:' + FAMHEX[o[0]] + '"' : '') + '>' + (on && !d.color ? '✓' : '') + '</span>'
            + '<span style="flex:1">' + esc(o[1]) + '</span><small style="color:#6b7280">' + esc(o[2] || '') + '</small></button>';
        }).join('') + '</div>';
      }
      h += '</div>';
    });
    h += '<span class="ww-count"><b style="color:#051024">' + list.length + '</b> styles' + (any ? ' <button class="ww-link" data-clear>Clear</button>' : '') + '</span></div>';
    if (!list.length) h += '<div class="ww-empty">No styles match these filters. <button class="ww-link" data-clear>Clear filters</button></div>';
    h += '<div class="ww-grid">' + list.map(function (s) {
      var shown = null;
      if (F.fam.length) { var m = s.colors.filter(function (c) { return F.fam.indexOf(fam(c.name)) >= 0; }); if (m.length) shown = m[0].name; }
      var mb = MAT[s.material], badges = (mb ? '<span class="ww-badge" style="color:' + mb[0] + ';background:' + mb[1] + '">' + esc(s.material) + '</span>' : '');
      return '<article class="ww-card"><a class="ww-img" href="#order/' + encodeURIComponent(s.code) + '" tabindex="-1">' + bestHtml(s) + imgHtml(s, shown) + '</a><div class="ww-cbody">'
        + '<div class="ww-badges">' + badges + '</div><h2 class="ww-cname">' + esc(s.name) + '</h2>'
        + '<div class="ww-dots" aria-label="Available colors">' + s.colors.slice(0, 8).map(function (c) { return '<span class="d" title="' + esc(c.name) + '" style="background:' + esc(c.hex) + '"></span>'; }).join('')
        + (s.colors.length > 8 ? '<small>+' + (s.colors.length - 8) + '</small>' : '') + '</div>'
        + (s.sizeChart || s.sizeTable ? '<button class="ww-link" style="padding:0;font-size:13px;text-align:left" data-chart="' + esc(s.code) + '">Size chart</button>' : '')
        + (s.from ? '<div class="ww-from">From <b>' + money(s.from) + '</b> / piece</div>' : '<div class="ww-from"></div>')
        + '<a class="ww-cta" href="#order/' + encodeURIComponent(s.code) + '" aria-label="Customize ' + esc(s.name) + '">Customize</a></div></article>';
    }).join('') + '</div>';
    h += '<p class="ww-note">"From" price: 25+ pieces with a 1-color left chest print. Your exact price shows as you build your order.</p>';
    app.innerHTML = h;
  }

  // ════════ ORDER ════════
  function addLine(code) { var st = byCode[code]; O.lines.push({ id: O.nextId++, code: code, color: (st.colors[0] || {}).name || '', sizes: {} }); O.quote = null; }
  function qtyOf(l) { return SIZES.reduce(function (a, s) { return a + (+l.sizes[s[0]] || 0); }, 0); }
  function total() { return O.lines.reduce(function (a, l) { return a + qtyOf(l); }, 0); }
  // light vs dark shirt (Silk Screen can't mix both in one order)
  function isLight(hex) {
    var m = /^#?([0-9a-f]{6})$/i.exec(hex || ''); if (!m) return true;
    var n = parseInt(m[1], 16), lin = function (c) { c /= 255; return c <= 0.04045 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4); };
    return 0.2126 * lin(n >> 16 & 255) + 0.7152 * lin(n >> 8 & 255) + 0.0722 * lin(n & 255) > 0.25;
  }
  function mixedShades() {
    var used = O.lines.filter(function (l) { return qtyOf(l) > 0; }).map(function (l) { return isLight(hexOf(byCode[l.code], l.color)); });
    return used.indexOf(true) >= 0 && used.indexOf(false) >= 0;
  }
  function silkFits() { return O.deco === 'print' && O.logoType === 'solid' && O.inks <= 3 && total() >= DATA.minimums.silk; }
  function method() {
    if (O.deco === 'emb') return 'emb';
    if (O.deco === 'print' && O.logoType) return silkFits() && !mixedShades() ? 'silk' : 'dtf';
    return null;
  }
  // Extra spots (sleeves, more spots) can carry the same logo or a different one.
  // Embroidery: each different logo has its own digitizing; the same logo in more spots is digitized once.
  function extraSpots() {
    var k = [];
    if (O.placement === 'other') for (var i = 1; i < O.otherSpots.length; i++) k.push(['o' + i, 'Spot ' + (i + 1)]);
    if (O.sleeves === 1) k.push(['sl', 'Sleeve']);
    if (O.sleeves === 2) { k.push(['sr', 'Right sleeve']); k.push(['sl', 'Left sleeve']); }
    return k;
  }
  function xl(key) { return O.xlogo[key] || (O.xlogo[key] = { diff: false, logo: null }); }
  function newLogos() { return extraSpots().filter(function (k) { return xl(k[0]).diff; }).length; }
  function logoFor(key) { var x = key && O.xlogo[key]; return x && x.diff ? x.logo : O.logo; }
  // "Best with" label set per style in the calculator (Website catalog → Best with)
  var BEST = { emb: 'Embroidery', silk: 'Silk Screen', dtf: 'DTF' };
  function bestHtml(s) { return BEST[s.bestFor] ? '<span class="ww-best">Best with <b>' + BEST[s.bestFor] + '</b></span>' : ''; }
  // step 2: suggest printed/embroidered only when every shirt in the order agrees
  function bestDeco() {
    var d = O.lines.map(function (l) { var b = (byCode[l.code] || {}).bestFor; return b === 'emb' ? 'emb' : b ? 'print' : ''; });
    return d.length && d[0] && d.every(function (x) { return x === d[0]; }) ? d[0] : '';
  }
  function orderBody(overrides) {
    var o = { deco: O.deco === 'emb' ? 'emb' : 'print', logoType: O.logoType || 'unsure', colors: O.inks, mixedShades: mixedShades(), reorder: (method() === 'silk' || method() === 'emb') && O.reorder, reorderNo: O.reorder ? O.reorderNo : '', placement: O.placement, otherSpots: O.placement === 'other' ? O.otherSpots : [], sleeves: O.sleeves, newLogos: newLogos(),
      items: O.lines.filter(function (l) { return qtyOf(l) > 0; }).map(function (l) {
        var q = { std: 0, x2: 0, x3: 0 }; SIZES.forEach(function (s) { q[s[1]] += +l.sizes[s[0]] || 0; });
        return { code: l.code, color: l.color, qty: q };
      }) };
    for (var k in overrides || {}) o[k] = overrides[k];
    return o;
  }
  var qTimer = null, qSeq = 0;
  function requote() {
    clearTimeout(qTimer);
    var m = method(), t = total();
    if (!m || !t || t < DATA.minimums[m]) { O.quote = null; O.upsell = null; renderAside(); return; }
    qTimer = setTimeout(function () {
      var seq = ++qSeq, body = orderBody();
      post(body).then(function (q) {
        if (seq !== qSeq) return; O.quote = q; renderAside();
        if (O.step === 4) { var ae = document.activeElement; if (ae && ae.dataset && ae.dataset.size && app.contains(ae)) O.dirty = true; else renderPanel(); }
      });
      // simple logo under 10 pieces: show what Silk Screen would cost at 10
      if (m === 'dtf' && O.logoType === 'solid' && O.inks <= 3 && t < DATA.minimums.silk && body.items.length) {
        var up = JSON.parse(JSON.stringify(body)); up.method = 'silk'; up.items[0].qty.std += DATA.minimums.silk - t;
        post(up).then(function (q) { if (seq !== qSeq) return; O.upsell = q && !q.errors.length ? q : null; if (O.step === 4) renderPanel(); });
      } else O.upsell = null;
    }, 250);
  }
  function post(body) {
    return fetch(API, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
      .then(function (r) { return r.json(); }).catch(function () { return null; });
  }

  function stepOk(n) {
    var m = method(), t = total();
    if (n === 1) return t > 0;
    if (n === 2) return !!O.deco;
    if (n === 3) return !!O.logo && (O.deco === 'emb' || O.logoType === 'unsure' || (!!O.logoType && O.confirmed));
    if (n === 4) return !!m && t >= DATA.minimums[m] && (O.placement !== 'other' || O.otherText.trim().length > 2) && extraSpots().every(function (k) { var x = xl(k[0]); return !x.diff || !!x.logo; });
    return true;
  }
  function maxStep() { var n = 1; while (n < 5 && stepOk(n)) n++; return n; }
  function go(n) { O.step = Math.max(1, Math.min(n, maxStep())); O.checkout = false; renderOrder(); window.scrollTo(0, app.offsetTop - 10); }

  function renderOrder() { hero.innerHTML = heroHtml(true); app.innerHTML = '<nav class="ww-steps" id="ww-steps" aria-label="Order steps"></nav><div class="ww-cols"><section class="ww-panel" id="ww-panel"></section><aside class="ww-aside" id="ww-aside"></aside></div>'; renderPanel(); requote(); renderAside(); }
  function renderSteps() {
    var ms = maxStep();
    document.getElementById('ww-steps').innerHTML = [['Pick your shirts', 1], ['Decoration', 2], ['Logo', 3], ['Logo placement', 4], ['Preview', 5]].map(function (x) {
      var n = x[1], skip = false;
      return (n > 1 ? '<span class="ww-sep" aria-hidden="true">›</span>' : '') + '<button class="ww-step' + (O.step === n ? ' cur' : n < O.step ? ' done' : '') + '" data-go="' + n + '"' + (n > ms || skip ? ' disabled' : '') + '><i>' + n + '</i><span class="ww-lbl">' + x[0] + '</span></button>';
    }).join('');
  }
  // sizes this style comes in (from its size table); the site sells XS–3XL
  function sizeTableHtml(st) {
    var t = st.sizeTable, keep = t.cols.map(function (c, i) { return SIZES.some(function (s) { return s[0] === c; }) ? i : -1; }).filter(function (i) { return i >= 0; });
    return '<div class="ww-tbl"><table><thead><tr><th></th>' + keep.map(function (i) { return '<th>' + esc(t.cols[i]) + '</th>'; }).join('') + '</tr></thead><tbody>'
      + t.rows.map(function (r) { return '<tr><th>' + esc(r.label) + '</th>' + keep.map(function (i) { return '<td>' + esc(r.values[i]) + '</td>'; }).join('') + '</tr>'; }).join('')
      + '</tbody></table></div><small class="ww-tnote">Measurements in inches. Lay a shirt you like flat and compare.</small>';
  }
  function sizesFor(code) { var t = (byCode[code] || {}).sizeTable; return t && t.cols ? SIZES.filter(function (s) { return t.cols.indexOf(s[0]) >= 0; }) : SIZES.filter(function (s) { return s[0] !== '2XS'; }); }
  function sizesHtml(l) {
    return '<div class="ww-sizes">' + sizesFor(l.code).map(function (s) {
      var q = +l.sizes[s[0]] || 0;
      return '<div class="ww-size"><label for="q' + l.id + s[0] + '">' + s[0] + '</label><div><button data-line="' + l.id + '" data-dec="' + s[0] + '" aria-label="Fewer ' + s[0] + '">−</button><input id="q' + l.id + s[0] + '" type="number" inputmode="numeric" min="0" value="' + (q || '') + '" placeholder="0" data-line="' + l.id + '" data-size="' + s[0] + '"><button data-line="' + l.id + '" data-inc="' + s[0] + '" aria-label="More ' + s[0] + '">+</button></div></div>';
    }).join('') + '</div>';
  }
  // quick quantity editor (step 4), so the client can add pieces without going back
  function quickAddHtml() {
    return '<div class="ww-quick">' + O.lines.map(function (l) {
      var st = byCode[l.code];
      return '<div class="ww-qline"><div class="ww-lhead" style="margin-bottom:6px"><div><span class="ww-thumb">' + imgHtml(st, l.color) + '</span><div><b style="font-size:13px">' + esc(st.name) + '</b><br><small style="color:#4b5563" id="pcs' + l.id + '">' + esc(l.color) + ' · ' + pcs(qtyOf(l)) + '</small></div></div></div>' + sizesHtml(l) + '</div>';
    }).join('') + '<div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap"><span style="font-size:14px">Total: <b id="ww-qtotal">' + pcs(total()) + '</b></span><button class="ww-pill on" data-quick="0">Done</button></div></div>';
  }
  function renderPanel() {
    renderSteps();
    var p = document.getElementById('ww-panel'), h = '', m = method(), t = total();
    if (O.step === 1) {
      h += '<h2 class="ww-h2">1. Pick your shirts</h2><p class="ww-p">Mix styles and colors. The minimum counts for the whole order, not per style.</p>';
      if (!O.lines.length) h += '<div class="ww-dash" style="margin-bottom:16px">Add a shirt below to start your order.</div>';
      O.lines.forEach(function (l) {
        var st = byCode[l.code];
        h += '<div class="ww-line"><button class="ww-lpic" data-zoompic="' + l.id + '" aria-label="See ' + esc(st.name) + ' in ' + esc(l.color) + ' bigger">' + imgHtml(st, l.color) + '</button><div class="ww-lbody"><div class="ww-lhead"><div><div><b style="font-size:15px">' + esc(st.name) + '</b><br><small style="color:#4b5563" id="pcs' + l.id + '">' + esc(l.color) + ' · ' + pcs(qtyOf(l)) + '</small></div></div>'
          + '<span style="white-space:nowrap">' + (st.sizeChart || st.sizeTable ? '<button class="ww-link" data-chart="' + esc(st.code) + '">Size chart</button>' : '') + '<button class="ww-link" data-dup="' + l.id + '">+ Another color</button><button class="ww-link" style="color:#4b5563" data-rm="' + l.id + '">Remove</button></span></div>'
          + '<div class="ww-lsec"><span class="ww-lab">Color</span><div class="ww-sw" role="group" aria-label="Color">' + st.colors.map(function (c) { return '<button class="' + (c.name === l.color ? 'on' : '') + '" style="background:' + esc(c.hex) + '" title="' + esc(c.name) + '" aria-label="' + esc(c.name) + '" data-line="' + l.id + '" data-color="' + esc(c.name) + '"></button>'; }).join('') + '</div></div>'
          + '<div class="ww-lsec bottom"><span class="ww-lab">Quantity per size</span>' + sizesHtml(l) + '</div></div></div>';
      });
      var collapsed = O.lines.length && !O.pickOpen;
      if (collapsed) h += '<button class="ww-addstyle" data-pick>+ Add another style</button>';
      else if (O.lines.length) h += '<div class="ww-q" style="margin-top:22px;display:flex;justify-content:space-between;align-items:center">Add another style<button class="ww-link" data-pick>Close</button></div>';
      if (!collapsed) {
