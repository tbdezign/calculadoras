          if (cols.list.length && cols.list.length <= 3 && cols.covered > 0.85) { O.logoType = 'solid'; O.inks = cols.list.length; O.logo.guess = 'We found ' + O.inks + ' solid color' + (O.inks === 1 ? '' : 's') + ' in your file:'; }
          else if (cols.list.length) { O.logoType = 'full'; O.logo.guess = 'Your file looks like it has many colors or effects.'; }
        } catch (e) {}
        renderPanel(); requote();
      };
      img.src = fr.result;
    };
    fr.readAsDataURL(file);
  }

  // ── events ──
  function lineById(id) { return O.lines.filter(function (l) { return String(l.id) === String(id); })[0]; }
  app.addEventListener('click', function (e) {
    var b = e.target.closest('button'); if (!b || !app.contains(b)) { if (F.open) { F.open = null; renderCatalog(); } return; }
    var ds = b.dataset;
    if (ds.zoompic) { var zl = lineById(ds.zoompic), zs = byCode[zl.code], zp = photoFor(zs, zl.color, 'front');
      openZoom('<div class="ww-chart" onclick="event.stopPropagation()"><b>' + esc(zs.name) + ' · ' + esc(zl.color) + '</b>' + (zp ? '<img src="' + esc(zp.url) + '" alt="">' : '<div style="width:min(70vw,420px);margin:auto">' + shapeSvg(zs.type, hexOf(zs, zl.color)) + '</div>') + '</div>'); return; }
    if (ds.chart) { var cs = byCode[ds.chart]; if (cs && (cs.sizeTable || cs.sizeChart)) openZoom('<div class="ww-chart" onclick="event.stopPropagation()"><b>' + esc(cs.name) + ' · size chart</b>' + (cs.sizeTable ? sizeTableHtml(cs) : '<img src="' + esc(cs.sizeChart) + '" alt="Size chart for ' + esc(cs.name) + '">') + '</div>'); return; }
    if (ds.dd) { F.open = F.open === ds.dd ? null : ds.dd; renderCatalog(); return; }
    if (ds.f) { var a = F[ds.f], i = a.indexOf(ds.v); if (i >= 0) a.splice(i, 1); else a.push(ds.v); renderCatalog(); return; }
    if ('clear' in ds) { F.type = []; F.fit = []; F.mat = []; F.fam = []; F.open = null; renderCatalog(); return; }
    if ('pick' in ds) { O.pickOpen = !O.pickOpen; O.showAll = false; renderPanel(); return; }
    if ('more' in ds) { O.showAll = !O.showAll; renderPanel(); return; }
    if (ds.add) { O.showAll = false; O.pickOpen = false; addLine(ds.add); renderPanel(); requote(); var ls = app.querySelectorAll('.ww-line'); if (ls.length) ls[ls.length - 1].scrollIntoView({ behavior: 'smooth', block: 'center' }); return; }
    if (ds.dup) { var src = lineById(ds.dup), st2 = byCode[src.code], usedC = O.lines.filter(function (x) { return x.code === src.code; }).map(function (x) { return x.color; });
      var next = st2.colors.filter(function (c) { return usedC.indexOf(c.name) < 0; })[0] || st2.colors[0];
      var nl = { id: O.nextId++, code: src.code, color: next ? next.name : '', sizes: {} }; O.lines.splice(O.lines.indexOf(src) + 1, 0, nl);
      renderPanel(); requote(); var el = document.getElementById('pcs' + nl.id); if (el) el.closest('.ww-line').scrollIntoView({ behavior: 'smooth', block: 'center' }); return; }
    if (ds.rm) { O.lines = O.lines.filter(function (l) { return String(l.id) !== ds.rm; }); renderPanel(); requote(); return; }
    if (ds.color) { lineById(ds.line).color = ds.color; renderPanel(); requote(); return; }
    if (ds.inc || ds.dec) { var l = lineById(ds.line), s = ds.inc || ds.dec; l.sizes[s] = Math.max(0, (+l.sizes[s] || 0) + (ds.inc ? 1 : -1)); renderPanel(); requote(); return; }
    if (ds.deco) { O.deco = ds.deco; if (ds.deco === 'emb' && /^(ff|bk|fb|lcb)$/.test(O.placement)) O.placement = 'lc'; renderPanel(); requote(); return; }
    if (ds.lt) { O.logoType = ds.lt; O.confirmed = false; renderPanel(); requote(); return; }
    if (ds.inks) { O.inks = +ds.inks; O.confirmed = false; renderPanel(); requote(); return; }
    if (ds.place) { O.placement = ds.place; renderPanel(); requote(); return; }
    if (ds.sleeves != null) { O.sleeves = +ds.sleeves; renderPanel(); requote(); return; }
    if (ds.xl != null) { xl(ds.xl).diff = ds.v === '1'; renderPanel(); requote(); return; }
    if (ds.spot != null) { O.otherSpots[+ds.spot] = ds.z; renderPanel(); requote(); return; }
    if (ds.rmspot != null) { O.otherSpots.splice(+ds.rmspot, 1); renderPanel(); requote(); return; }
    if ('addspot' in ds) { O.otherSpots.push('small'); renderPanel(); requote(); return; }
    if (ds.quick != null) { O.quick = ds.quick === '1'; renderPanel(); var qb = app.querySelector('.ww-quick input'); if (qb && O.quick) qb.closest('.ww-quick').scrollIntoView({ behavior: 'smooth', block: 'nearest' }); return; }
    if (ds.reorder != null) { O.reorder = ds.reorder === '1'; renderPanel(); requote(); return; }
    if (ds.go) { go(+ds.go); return; }
    if ('next' in ds) { go(O.step + 1); return; }
    if ('back' in ds) { go(O.step - 1); return; }
    if ('pay' in ds) { O.checkout = true; renderPanel(); return; }
  });
  // tap a preview to see it big
  function closeZoom() { var z = document.querySelector('.ww-zoom'); if (z) z.remove(); document.removeEventListener('keydown', zoomKey); }
  function zoomKey(e) { if (e.key === 'Escape') closeZoom(); }
  function openZoom(content) {
    closeZoom();
    var z = document.createElement('div'); z.className = 'ww ww-zoom'; z.setAttribute('role', 'dialog'); z.setAttribute('aria-label', 'Enlarged view');
    z.innerHTML = '<button class="ww-zoom-x" aria-label="Close">×</button>';
    if (typeof content === 'string') z.insertAdjacentHTML('beforeend', content); else z.appendChild(content);
    z.addEventListener('click', closeZoom); document.body.appendChild(z); document.addEventListener('keydown', zoomKey);
  }
  app.addEventListener('click', function (e) {
    var pi = e.target.closest('.ww-prev .ww-pimg'); if (pi) openZoom(pi.cloneNode(true));
  });
  app.addEventListener('focusout', function (e) { if (e.target.dataset && e.target.dataset.size && O.step === 4) setTimeout(function () { var ae = document.activeElement; if (!(ae && ae.dataset && ae.dataset.size)) { O.dirty = false; renderPanel(); } }, 0); });
  app.addEventListener('change', function (e) {
