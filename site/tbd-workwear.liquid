    if (e.target.dataset && e.target.dataset.xfile && e.target.files[0]) {
      var xf = e.target.files[0], xk = e.target.dataset.xfile; xl(xk).logo = { name: xf.name, url: null };
      if (/^image\//.test(xf.type)) { var xr = new FileReader(); xr.onload = function () { xl(xk).logo.url = xr.result; renderPanel(); }; xr.readAsDataURL(xf); } else renderPanel();
    }
  });
  app.addEventListener('input', function (e) {
    var t = e.target;
    if (t.dataset.size) { var ln = lineById(t.dataset.line); ln.sizes[t.dataset.size] = Math.max(0, parseInt(t.value, 10) || 0); requote(); renderSteps();
      var pc = document.getElementById('pcs' + ln.id); if (pc) pc.textContent = ln.color + ' · ' + pcs(qtyOf(ln));
      var qt = document.getElementById('ww-qtotal'); if (qt) qt.textContent = pcs(total());
      var nb = app.querySelector('[data-next]'); if (nb) nb.disabled = !stepOk(O.step); }
